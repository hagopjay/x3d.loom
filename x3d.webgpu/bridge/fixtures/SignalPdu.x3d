<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="DIS" level="2"/><meta name="title" content="SignalPdu.x3d"/><meta name="description" content="Bridge fixture for SignalPdu: stores its fields and its sample data, draws and plays nothing, no output ever fires (X_ITE 16.6.0)"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="2 2 2"/></Shape>
    <SignalPdu DEF="N"/>
    <SignalPdu DEF="R2" data="1 2 3" dataLength="3" encodingScheme="4" sampleRate="8000" samples="3" tdlType="9" radioID="2" siteID="3" applicationID="4" entityID="5" whichGeometry="0" rtpHeaderExpected="true" networkMode="networkWriter"/>
  </Scene>
