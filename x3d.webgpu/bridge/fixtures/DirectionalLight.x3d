<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="DirectionalLight.x3d"/><meta name="description" content="Bridge fixture for DirectionalLight: the upper pair of spheres is lit by a world light whose direction a Transform above it turns; below, a light with the default global FALSE in a group lights only the sphere inside the group"/></head>
  <Scene>
    <NavigationInfo headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Transform DEF="T"><DirectionalLight DEF="D" global="true" direction="0 0 -1" color="1 0.9 0.8" intensity="1"/></Transform>
    <Transform translation="-3 1.5 0"><Shape><Appearance><Material diffuseColor="0.2 0.5 0.9" specularColor="0.6 0.6 0.6" shininess="0.3"/></Appearance><Sphere radius="1.2"/></Shape></Transform>
    <Transform translation="3 1.5 0"><Shape><Appearance><Material diffuseColor="0.9 0.4 0.2"/></Appearance><Sphere radius="1.2"/></Shape></Transform>
    <Group DEF="SCOPE"><DirectionalLight DEF="DS" direction="1 -0.3 -1" color="0.3 1 0.3" intensity="1"/><Transform translation="-3 -2 0"><Shape><Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance><Sphere radius="1.0"/></Shape></Transform></Group>
    <Transform translation="3 -2 0"><Shape><Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance><Sphere radius="1.0"/></Shape></Transform>
  </Scene>
</X3D>
