<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="SpatialSound.x3d"/><meta name="description" content="Bridge fixture for SpatialSound: a sound with a place, panner settings and the position through the camera"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Transform translation="1 0 0">
      <SpatialSound DEF="N" location="0 1 0">
        <BufferAudioSource DEF="S"/>
      </SpatialSound>
    </Transform>
  </Scene>
</X3D>
