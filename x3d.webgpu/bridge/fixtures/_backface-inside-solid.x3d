<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="_backface-inside-solid.x3d"/><meta name="description" content="Bridge fixture: the camera inside a solid=false Box; the far wall faces away from the camera and is lit through two sided lighting."/></head>
  <Scene>
    <Viewpoint position="0 0 3"/>
    <Background skyColor="0 0 1"/>
    <Shape><Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance><Box size="20 20 20" solid="true"/></Shape>
  </Scene>
</X3D>
