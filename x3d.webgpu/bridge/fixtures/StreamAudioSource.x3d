<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="StreamAudioSource.x3d"/><meta name="description" content="Bridge fixture for StreamAudioSource: sound from a network stream (not supported by X_ITE), clock only"/></head>
  <Scene>
    <StreamAudioSource DEF="N"/>
    <StreamAudioDestination DEF="SDE" streamIdentifier="loop">
      <OscillatorSource DEF="SO" frequency="1000"><PeriodicWave type="SINE"/></OscillatorSource>
    </StreamAudioDestination>
    <StreamAudioSource DEF="SSR" streamIdentifier="loop"/>
  </Scene>
</X3D>
