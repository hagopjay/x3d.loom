<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="ImageTexture.x3d"/><meta name="description" content="a 4x4 PNG with four quadrant colours (red green / blue yellow, red top left) as a data URI on an IndexedFaceSet quad with texture coordinates: orientation and the hard texels X_ITE uses for an image under 16 x 16 (the same image on a Box is upside down in the Babylon body: a gap, see the spec)"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="0 0 0"><Shape><Appearance><Material diffuseColor="1 1 1"/><ImageTexture url='"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAAECAIAAAAmkwkpAAAAGklEQVR4nGP4z8AARAz/kRCMAtP//wMxKgcAyncT7VDvvoMAAAAASUVORK5CYII="'/></Appearance><IndexedFaceSet coordIndex="0 1 2 3 -1"><Coordinate point="-1 -1 0 1 -1 0 1 1 0 -1 1 0"/><TextureCoordinate point="0 0 1 0 1 1 0 1"/></IndexedFaceSet></Shape></Transform>
  </Scene>
</X3D>
