<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="StreamAudioDestination.x3d"/><meta name="description" content="Bridge fixture for StreamAudioDestination: sound out to a network stream (not supported by X_ITE)"/></head>
  <Scene>
    <StreamAudioDestination DEF="N">
      <BufferAudioSource DEF="S"/>
    </StreamAudioDestination>
  </Scene>
</X3D>
