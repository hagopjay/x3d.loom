<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="PointSet.x3d"/><meta name="description" content="Bridge fixture for PointSet: a plain PointSet (no PointProperties), five points"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Shape DEF="S1"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><PointSet DEF="G1"><Coordinate point="-3 -1 0, -1 1 0, 1 -1 0, 3 1 0, 0 0 0"/></PointSet></Shape>
  </Scene>
</X3D>
