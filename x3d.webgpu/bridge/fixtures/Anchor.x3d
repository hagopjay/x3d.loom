<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Anchor.x3d"/><meta name="description" content="Bridge fixture for Anchor"/></head>
  <Scene>
    <Viewpoint DEF="V1" position="0 0 10" description="home"/>
    <Viewpoint DEF="V2" position="0 0 6" description="closer"/>
    <Anchor DEF="A" url='"#V2"' description="go closer"><Transform DEF="T"><Shape><Appearance><Material diffuseColor="0.9 0.35 0.2"/></Appearance><Box size="2 2 2"/></Shape></Transform></Anchor>
    <Switch whichChoice="-1"><Transform DEF="T2" translation="3 0 0"><Shape><Appearance><Material diffuseColor="0.2 0.5 0.9"/></Appearance><Box size="2 2 2"/></Shape></Transform></Switch>
  </Scene>
</X3D>
