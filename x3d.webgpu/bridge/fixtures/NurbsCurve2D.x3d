<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="NurbsCurve2D.x3d"/><meta name="description" content="Bridge fixture for NurbsCurve2D"/></head>
  <Scene>
    <NurbsCurve2D DEF="A" order="3" tessellation="8" controlPoint="0 0, 1 2, 3 2, 4 0"/>
    <NurbsCurve2D DEF="B" order="3" closed="true" tessellation="12" controlPoint="0 0, 2 0, 2 2, 0 2, 0 0"/>
    <NurbsCurve2D DEF="C" order="2" knot="0 0 0.4 1 1" tessellation="7" controlPoint="0 0, 1 1, 3 0"/>
    <NurbsCurve2D DEF="D" order="4" knot="0 0 0 0 0.2 0.6 1 1 1 1" tessellation="-2" controlPoint="0 0, 1 3, 2 -1, 3 2, 4 0, 5 1"/>
    <NurbsCurve2D DEF="E" order="3" knot="0 0 0 1 1 1" tessellation="8" weight="1 0.70710678 1" controlPoint="1 0, 1 1, 0 1"/>
    <NurbsCurve2D DEF="F" order="4" tessellation="6" controlPoint="0 0, 1 1, 2 0"/>
    <NurbsCurve2D DEF="G" order="3" knot="0 1 0.5 2 3 4 5 6" tessellation="6" controlPoint="0 0, 1 1, 2 0, 3 1, 4 0"/>
    <NurbsCurve2D DEF="H" order="3" closed="true" tessellation="6" controlPoint="0 0, 2 0, 2 2, 0 2"/>
    <NurbsCurve2D DEF="I" order="3" controlPoint="0 0, 1 2, 3 2, 4 0"/>
    <NurbsCurve2D DEF="J" order="3" closed="true" tessellation="9" weight="1 1 1 1 1" controlPoint="0 0, 2 0, 2 2, 0 2, 0 0"/>
  </Scene>
</X3D>
