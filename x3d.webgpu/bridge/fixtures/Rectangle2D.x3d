<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Rectangle2D.x3d"/><meta name="description" content="Bridge fixture for Rectangle2D: a 2.4 x 1.6 rectangle, the default 2 x 2 and a turned 3 x 0.8"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Transform translation="-3.5 0 0"><Shape DEF="S1"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Rectangle2D DEF="R1" size="2.4 1.6"/></Shape><TouchSensor DEF="T1"/></Transform>
    <Transform translation="0 0 0"><Shape DEF="S2"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Rectangle2D DEF="R2"/></Shape><TouchSensor DEF="T2"/></Transform>
    <Transform translation="3.5 0 0" rotation="0 1 0 0.6"><Shape DEF="S3"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Rectangle2D DEF="R3" size="3 0.8"/></Shape><TouchSensor DEF="T3"/></Transform>
  </Scene>
</X3D>
