<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="CADGeometry" level="2"/><meta name="title" content="IndexedQuadSet.x3d"/><meta name="description" content="Bridge fixture for IndexedQuadSet: flat shapes in the z=0 plane, a TouchSensor next to each tells where the pointer is over them"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Group>
      <Shape DEF="S"><Appearance><Material diffuseColor="0.2 0.7 0.9"/></Appearance>
        <IndexedQuadSet DEF="G" index="0 1 4 3 1 2 5 4"><Coordinate point="-2 -1 0, 0 -1 0, 2 -1 0, -2 1 0, 0 1 0, 2 1 0"/></IndexedQuadSet>
      </Shape>
      <TouchSensor DEF="TS"/>
    </Group>
  </Scene>
</X3D>
