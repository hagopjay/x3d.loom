<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="Gain.x3d"/><meta name="description" content="Bridge fixture for Gain: volume control, disabled passes the signal at gain 1"/></head>
  <Scene>
    <Gain DEF="N">
      <BufferAudioSource DEF="S"/>
    </Gain>
  </Scene>
</X3D>
