<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layering" level="1"/><meta name="title" content="Layer.x3d"/><meta name="description" content="Bridge fixture for Layer: a layer with a blue box, drawn over the empty world, visible, and the held fields (the last LayerSet of the scene is the active one in both engines; the first is a spare that stays unused)"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <LayerSet DEF="Spare">
      <Layer DEF="P">
        <Transform translation="0 0 0"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="2 2 2"/></Shape></Transform>
      </Layer>
    </LayerSet>
    <LayerSet order="0 1">
      <Layer DEF="N">
        <Transform translation="0 0 0"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="2 2 2"/></Shape></Transform>
      </Layer>
    </LayerSet>
  </Scene>
</X3D>
