<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Texturing3D" level="1"/><meta name="title" content="PixelTexture3D.x3d"/><meta name="description" content="Bridge fixture for PixelTexture3D: a 2 by 2 by 2 volume on a box; the box has 2D texture coordinates, so its first slice shows"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
