<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Interpolation" level="3"/><meta name="title" content="CoordinateInterpolator2D.x3d"/><meta name="description" content="Bridge fixture for CoordinateInterpolator2D: a list of points interpolated between key frames"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <CoordinateInterpolator2D DEF="N" key="0 0.5 1" keyValue="0 0, 2 0,  1 1, 3 1,  2 4, 4 4"/>
    <CoordinateInterpolator2D DEF="N2" key="" keyValue=""/>
    <CoordinateInterpolator2D DEF="N3" key="0 1" keyValue="0 0, 2 0, 4 0, 6 0"/>
  </Scene>
</X3D>
