    <NavigationInfo headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <VolumeData dimensions="1 1 1"><PixelTexture3D DEF="T" containerField="voxels" image="1 4 4 4 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 72 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8"/><BoundaryEnhancementVolumeStyle DEF="N" containerField="renderStyle"/></VolumeData>
  </Scene>
