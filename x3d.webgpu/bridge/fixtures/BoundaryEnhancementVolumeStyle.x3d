<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="VolumeRendering" level="3"/><component name="Texturing3D" level="1"/><meta name="title" content="BoundaryEnhancementVolumeStyle.x3d"/><meta name="description" content="Bridge fixture for BoundaryEnhancementVolumeStyle: four layers of voxels seen end on, a boundary between layers raises the opacity"/></head>
  <Scene>
