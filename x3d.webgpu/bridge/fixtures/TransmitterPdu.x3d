<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="DIS" level="2"/><meta name="title" content="TransmitterPdu.x3d"/><meta name="description" content="Bridge fixture for TransmitterPdu: stores its fields, draws nothing, transmits nothing, no output ever fires (X_ITE 16.6.0)"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="2 2 2"/></Shape>
    <TransmitterPdu DEF="N"/>
    <TransmitterPdu DEF="R2" antennaLocation="1 2 3" relativeAntennaLocation="4 5 6" power="12.5" frequency="12345" transmitFrequencyBandwidth="3.5" transmitState="2" geoCoords="10 20 30" geoSystem='"UTM" "Z3" "N"'/>
  </Scene>
</X3D>
