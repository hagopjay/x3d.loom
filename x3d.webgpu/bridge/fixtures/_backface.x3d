<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="_backface.x3d"/><meta name="description" content="Bridge fixture: lit back faces of solid=false shapes. Three quads in the z=0 plane, a lit white one wound towards the camera (control), one wound away from it (solid false, must be lit like the control), and one wound away with solid TRUE (culled, shows the background)."/></head>
  <Scene>
    <Viewpoint position="0 0 3"/>
    <Background skyColor="0 0 1"/>
    <Shape><Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance>
      <IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1"><Coordinate point="-1.0 -0.4 0, -0.2 -0.4 0, -0.2 0.4 0, -1.0 0.4 0"/></IndexedFaceSet></Shape>
    <Shape><Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance>
      <IndexedFaceSet solid="false" coordIndex="3 2 1 0 -1"><Coordinate point="0.2 -0.4 0, 1.0 -0.4 0, 1.0 0.4 0, 0.2 0.4 0"/></IndexedFaceSet></Shape>
    <Shape><Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance>
      <IndexedFaceSet solid="true" coordIndex="3 2 1 0 -1"><Coordinate point="-0.4 -1.2 0, 0.4 -1.2 0, 0.4 -0.7 0, -0.4 -0.7 0"/></IndexedFaceSet></Shape>
  </Scene>
</X3D>
