<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="RigidBodyPhysics" level="2"/><meta name="title" content="CollisionCollection.x3d"/><meta name="description" content="Bridge fixture for CollisionCollection: bounce off a wall, and the friction that stops a sliding box"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <RigidBodyCollection DEF="W" >
      <RigidBody DEF="G" position="0 -0.5 0" mass="1" fixed="true" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Box size="20 1 20"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="WALL" position="5 1 0" mass="1" fixed="true" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Box size="1 4 14"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="S0" position="0 0.5 -3" mass="1" linearVelocity="4 0 0"><CollidableShape containerField="geometry"><Shape containerField="shape"><Box size="1 1 1"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="BL" position="3 3 3" mass="1" linearVelocity="4 0 0" useGlobalGravity="false"><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="0.5"/></Shape></CollidableShape></RigidBody>
      <CollisionCollection containerField="collider" DEF="C" bounce="1" minBounceSpeed="0" frictionCoefficients="0.5 0.5"/>
    </RigidBodyCollection>
  </Scene>
</X3D>
