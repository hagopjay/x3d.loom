<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layering" level="1"/><component name="Layout" level="2"/><component name="Navigation" level="3"/><component name="Text" level="1"/><meta name="title" content="ScreenFontStyle.x3d"/><meta name="description" content="Bridge fixture for ScreenFontStyle: a Text with a screen font style, every field read and set"/></head>
  <Scene>
    <Shape><Appearance><Material emissiveColor="1 1 1"/></Appearance><Text string='"Hello"'><ScreenFontStyle DEF="N"/></Text></Shape>
  </Scene>
</X3D>
