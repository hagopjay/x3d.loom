<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="TextureBackground.x3d"/><meta name="description" content="Bridge fixture for TextureBackground"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint DEF="V0" position="0 0 10"/>
    <Viewpoint DEF="Vup" position="0 0 10" orientation="1 0 0 1.2"/>
    <Viewpoint DEF="Vtop" position="0 0 10" orientation="1 0 0 1.5707963"/>
    <Viewpoint DEF="Vright" position="0 0 10" orientation="0 1 0 -1.5707963"/>
    <Viewpoint DEF="Vdown" position="0 0 10" orientation="1 0 0 -1.5707963"/>
    <Viewpoint DEF="Vleft" position="0 0 10" orientation="0 1 0 1.5707963"/>
    <TextureBackground DEF="A" skyColor="0 0 1, 0.5 0.5 1" skyAngle="1.2" groundColor="0.3 0.2 0.1, 0.1 0.1 0.1" groundAngle="1.2"/>
    <TextureBackground DEF="B" skyColor="0.2 0.2 0.2">
      <ImageTexture containerField="frontTexture" url='"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC"'/>
      <ImageTexture containerField="leftTexture" url='"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGNg+M8AAAICAQB7CYF4AAAAAElFTkSuQmCC"'/>
      <ImageTexture containerField="topTexture" url='"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAHElEQVR4nGP4z8AARwz/cSAKJZB5//8zwBEVJQC2jU+xpR5PuwAAAABJRU5ErkJggg=="'/>
      <PixelTexture containerField="rightTexture" image="1 1 3 0xff8000"/>
