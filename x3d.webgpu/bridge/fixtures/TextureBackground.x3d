    <Background DEF="C" skyColor="0 1 0"/>
    <Group>
      <Shape DEF="BOX"><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 1 1"/></Appearance><Box size="2 2 2"/></Shape>
      <TouchSensor DEF="TS"/>
