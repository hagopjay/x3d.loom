<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Shaders" level="1"/><meta name="title" content="ShaderProgram.x3d"/><meta name="description" content="Bridge fixture for ShaderProgram: a program kept by a ProgramShader that neither X_ITE nor the bridge runs"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Shape><Appearance><Material emissiveColor="1 0 0"/><ProgramShader DEF="P" language="GLSL"><ShaderProgram DEF="N" type="FRAGMENT" url='"data:x-shader/x-fragment,void main() { }"'/></ProgramShader></Appearance><Box/></Shape>
  </Scene>
</X3D>
