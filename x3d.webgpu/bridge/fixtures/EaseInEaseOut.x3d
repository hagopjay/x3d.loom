<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="EaseInEaseOut.x3d"/><meta name="description" content="Bridge fixture for EaseInEaseOut"/></head>
  <Scene>
    <EaseInEaseOut DEF="N" key="0 0.5 1" easeInEaseOut="0 0.3, 0.2 0.2, 0.4 0"/>
    <EaseInEaseOut DEF="Sym" key="0 1" easeInEaseOut="0 0.25, 0.25 0"/>
    <EaseInEaseOut DEF="Over" key="0 1" easeInEaseOut="0 0.8, 0.8 0"/>
    <EaseInEaseOut DEF="Neg" key="0 1" easeInEaseOut="0 -1, 0 0"/>
    <EaseInEaseOut DEF="Short" key="0 0.5 1" easeInEaseOut="0 0.4"/>
    <EaseInEaseOut DEF="Zero" key="0 1"/>
  </Scene>
</X3D>
