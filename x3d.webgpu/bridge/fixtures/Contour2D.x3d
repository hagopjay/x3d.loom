<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Contour2D.x3d"/><meta name="description" content="Bridge fixture for Contour2D"/></head>
  <Scene>
    <Contour2D DEF="K">
      <NurbsCurve2D DEF="N1" tessellation="4" controlPoint="0 0, 1 1, 2 0"/>
      <ContourPolyline2D DEF="P1" controlPoint="2 0, 2 2"/>
    </Contour2D>
    <NurbsCurve2D DEF="N2" order="2" tessellation="3" controlPoint="2 2, 0 2"/>
    <ContourPolyline2D DEF="P2" controlPoint="0 2, 0 0"/>
    <Contour2D DEF="K2"/>
  </Scene>
</X3D>
