<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="_def-use-occurrences.x3d"/><meta name="description" content="Bridge regression: one Transform DEF'd once and USEd under a second parent is two rendered occurrences; a later translation change must move both"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Background skyColor="0 0 0"/>
    <Viewpoint position="0 0 10"/>
    <Transform translation="-2 0 0">
      <Transform DEF="Shared">
        <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="1 1 1"/></Shape>
      </Transform>
    </Transform>
    <Transform translation="2 0 0">
      <Transform USE="Shared"/>
    </Transform>
  </Scene>
</X3D>
