<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Picking" level="3"/><component name="Layering" level="1"/><component name="Layout" level="1"/><component name="Navigation" level="3"/><component name="Text" level="1"/><meta name="title" content="LayoutLayer.x3d"/><meta name="description" content="Bridge fixture for LayoutLayer: a layer seen through an orthographic camera, a blue box, a Viewport that clips it, visible and the held fields"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Switch whichChoice="-1"><Transform DEF="LX" translation="0.8 0 0"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="0.5 0.5 0.5"/></Shape></Transform></Switch>
    <LayerSet order="0 1">
      <LayoutLayer DEF="N">
        <Viewport DEF="V" containerField="viewport" clipBoundary="0 1 0 1"/>
        <Transform DEF="LT"><TouchSensor DEF="LTS"/><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box DEF="LB" size="1 1 1"/></Shape></Transform>
        <Transform><Shape><Box size="0.02 0.02 0.02"/></Shape>
          <PointPickSensor DEF="PS" intersectionType="GEOMETRY"><PointSet containerField="pickingGeometry"><Coordinate point="0 0 0"/></PointSet><Transform USE="LT" containerField="pickTarget"/></PointPickSensor>
        </Transform>
      </LayoutLayer>
    </LayerSet>
  </Scene>
</X3D>
