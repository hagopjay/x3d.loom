<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layout" level="2"/><meta name="title" content="ScreenGroup.x3d"/><meta name="description" content="Bridge fixture for ScreenGroup: a box 50 units wide that stays 50 pixels wide wherever its group is moved in depth"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Transform DEF="T"><ScreenGroup DEF="N"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="50 50 50"/></Shape></ScreenGroup></Transform>
  </Scene>
</X3D>
