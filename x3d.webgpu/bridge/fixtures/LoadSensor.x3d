<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="LoadSensor.x3d"/><meta name="description" content="Bridge fixture for LoadSensor"/></head>
  <Scene>
    <LoadSensor DEF="Ok"><ImageTexture containerField="children" url='"px.png"'/></LoadSensor>
    <LoadSensor DEF="Bad"><ImageTexture containerField="children" url='"missing.png"'/></LoadSensor>
    <LoadSensor DEF="Slow" timeOut="0.5"><ImageTexture containerField="children" url='"slow.png"'/></LoadSensor>
    <LoadSensor DEF="Off" enabled="false"><ImageTexture containerField="children" url='"px.png"'/></LoadSensor>
    <LoadSensor DEF="Empty"/>
  </Scene>
</X3D>
