<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="ChannelSplitter.x3d"/><meta name="description" content="Bridge fixture for ChannelSplitter: one input split over two output nodes"/></head>
  <Scene>
    <ChannelSplitter DEF="N">
      <BufferAudioSource DEF="S"/>
      <Gain DEF="O1" containerField="outputs"/>
      <Gain DEF="O2" containerField="outputs"/>
    </ChannelSplitter>
  </Scene>
</X3D>
