<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="CADGeometry" level="2"/><meta name="title" content="QuadSet.x3d"/><meta name="description" content="Bridge fixture for QuadSet: flat shapes in the z=0 plane, a TouchSensor next to each tells where the pointer is over them"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Group>
      <Shape DEF="S"><Appearance><Material diffuseColor="0.2 0.7 0.9"/></Appearance>
        <QuadSet DEF="G" colorPerVertex="false"><Coordinate point="-3 -1 0, -1 -1 0, -1 1 0, -3 1 0, 1 -1 0, 3 -1 0, 2.5 1 0, 1.5 1 0"/><Color color="1 0 0, 0 0 1"/></QuadSet>
      </Shape>
      <TouchSensor DEF="TS"/>
    </Group>
  </Scene>
</X3D>
