<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="CoordinateDouble.x3d"/><meta name="description" content="Bridge fixture for CoordinateDouble"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Group>
      <Shape><Appearance><Material diffuseColor="0.9 0.5 0.2"/></Appearance>
        <IndexedFaceSet coordIndex="0 1 2 -1"><CoordinateDouble DEF="N" point="-1.5 -1 0, 1.5 -1 0, 0 1.5 0"/></IndexedFaceSet>
      </Shape>
      <Shape><Appearance><Material diffuseColor="0.2 0.5 0.9"/></Appearance>
        <IndexedTriangleSet index="0 1 2"><CoordinateDouble DEF="M" point="2.5 -1 0, 4.5 -1 0, 3.5 1 0"/></IndexedTriangleSet>
      </Shape>
      <TouchSensor DEF="TS"/>
    </Group>
  </Scene>
</X3D>
