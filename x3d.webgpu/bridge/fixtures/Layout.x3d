<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layering" level="1"/><component name="Layout" level="1"/><component name="Navigation" level="3"/><component name="Text" level="1"/><meta name="title" content="Layout.x3d"/><meta name="description" content="Bridge fixture for Layout: a LayoutLayer whose Layout is changed through its units, alignment, offset and scale modes; a blue box shows where the layout puts it"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <LayerSet order="0 1">
      <LayoutLayer DEF="LL">
        <Layout DEF="LY" align='"CENTER" "CENTER"' offsetUnits='"WORLD" "WORLD"' offset="0 0" sizeUnits='"WORLD" "WORLD"' size="1 1" scaleMode='"NONE" "NONE"'/>
        <Transform><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="1 1 1"/></Shape></Transform>
      </LayoutLayer>
    </LayerSet>
  </Scene>
</X3D>
