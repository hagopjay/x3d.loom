<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Circle2D.x3d"/><meta name="description" content="Bridge fixture for Circle2D"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Shape DEF="S1"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Circle2D DEF="G1" radius="2"/></Shape>
    <Transform translation="4 0 0"><Shape DEF="S2"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Circle2D DEF="G2" radius="0.5"/></Shape></Transform>
  </Scene>
</X3D>
