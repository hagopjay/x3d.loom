<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="VisibilitySensor.x3d"/><meta name="description" content="Bridge fixture for VisibilitySensor: a box of sensor volume that is moved behind the viewer and back"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Transform DEF="T">
      <Shape><Appearance><Material diffuseColor="0.2 0.6 0.9"/></Appearance><Box size="2 2 2"/></Shape>
      <VisibilitySensor DEF="N" size="2 2 2"/>
    </Transform>
  </Scene>
</X3D>
