<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="RigidBodyPhysics" level="2"/><meta name="title" content="CollidableOffset.x3d"/><meta name="description" content="Bridge fixture for CollidableOffset: a sphere offset 1 below the body origin makes the body rest 1.5 up"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <RigidBodyCollection DEF="W" >
      <RigidBody DEF="G" position="0 -0.5 0" mass="1" fixed="true" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Box size="20 1 20"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="N0" position="0 4 0" mass="1" ><CollidableOffset DEF="OFF" containerField="geometry" translation="0 -1 0"><CollidableShape containerField="collidable"><Shape containerField="shape"><Sphere radius="0.5"/></Shape></CollidableShape></CollidableOffset></RigidBody>
      <CollisionCollection containerField="collider" bounce="0"/>
    </RigidBodyCollection>
  </Scene>
</X3D>
