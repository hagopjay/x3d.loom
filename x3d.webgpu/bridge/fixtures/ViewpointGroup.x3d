<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="ViewpointGroup.x3d"/><meta name="description" content="Bridge fixture for ViewpointGroup"/></head>
  <Scene>
    <Viewpoint description="Top level" position="0 0 10"/>
    <ViewpointGroup DEF="G1" description="Rooms">
      <Viewpoint description="Hall" position="0 0 5"/>
      <ViewpointGroup DEF="G2" description="Upstairs"><Viewpoint description="Attic" position="0 5 5"/></ViewpointGroup>
      <Viewpoint position="1 1 1"/>
    </ViewpointGroup>
    <ViewpointGroup DEF="G3" description="Near" size="2 2 2" center="20 0 0"><Viewpoint description="Far room" position="20 0 5"/></ViewpointGroup>
    <ViewpointGroup DEF="G4" displayed="false" description="Hidden"><Viewpoint description="Secret"/></ViewpointGroup>
    <Group><Shape><Appearance><Material/></Appearance><Box/></Shape></Group>
  </Scene>
</X3D>
