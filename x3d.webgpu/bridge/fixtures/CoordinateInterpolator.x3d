<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Interpolation" level="1"/><meta name="title" content="CoordinateInterpolator.x3d"/><meta name="description" content="Bridge fixture for CoordinateInterpolator: a list of points interpolated between key frames"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <CoordinateInterpolator DEF="N" key="0 0.5 1" keyValue="0 0 0, 2 0 0,  1 1 0, 3 1 0,  2 4 0, 4 4 0"/>
    <CoordinateInterpolator DEF="N2" key="" keyValue=""/>
    <CoordinateInterpolator DEF="N3" key="0 1" keyValue="0 0 0, 2 0 0, 4 0 0, 6 0 0"/>
  </Scene>
</X3D>
