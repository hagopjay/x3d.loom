<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="DIS" level="2"/><meta name="title" content="DISEntityTypeMapping.x3d"/><meta name="description" content="Bridge fixture for DISEntityTypeMapping: holds the entity type and the url, never loads the url, draws nothing"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="2 2 2"/></Shape>
    <DISEntityTypeMapping DEF="N"/>
    <DISEntityTypeMapping DEF="T2" category="1" country="225" domain="1" kind="1" extra="4" specific="5" subcategory="6" description="a tank" url='"tank.x3d" "tank.glb"' load="false" autoRefresh="30" autoRefreshTimeLimit="600"/>
    <DISEntityManager DEF="M"><DISEntityTypeMapping DEF="T3" category="2" country="3"/></DISEntityManager>
  </Scene>
</X3D>
