<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="ListenerPointSource.x3d"/><meta name="description" content="Bridge fixture for ListenerPointSource: the audio listener placed by a node in the scene"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Transform translation="1 2 3">
      <ListenerPointSource DEF="N" position="0 0 -2" orientation="0 1 0 1.5708"/>
    </Transform>
  </Scene>
</X3D>
