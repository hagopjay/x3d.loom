<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Geospatial" level="2"/><meta name="title" content="GeoPositionInterpolator.x3d"/><meta name="description" content="Bridge fixture for GeoPositionInterpolator: great-circle interpolation of geographic positions"/></head>
  <Scene>
    <GeoPositionInterpolator DEF="I" key="0 1" keyValue="0 0 0, 0 90 0"/>
    <GeoPositionInterpolator DEF="J" key="0 1" keyValue="0 0 0, 60 0 0"/>
    <GeoPositionInterpolator DEF="K" key="0 1" keyValue="0 0 0, 60 0 100000"/>
    <GeoPositionInterpolator DEF="M" key="0 0.5 1" keyValue="0 0 0, 0 90 0, 90 90 0"/>
    <GeoPositionInterpolator DEF="S" key="0 0.5 0.5 1" keyValue="0 0 0, 0 10 0, 0 20 0, 0 30 0"/>
    <GeoPositionInterpolator DEF="P" key="0 0.5 1" keyValue="0 0 0, 0 90 0"/>
    <GeoPositionInterpolator DEF="L" key="0 1" geoSystem='"GD" "WE" "longitude_first"' keyValue="0 0 0, 90 0 0"/>
    <GeoPositionInterpolator DEF="C" key="0 1" geoSystem='"GC"' keyValue="6378137 0 0, 0 6378137 0"/>
    <GeoPositionInterpolator DEF="E" key="0 1" keyValue="0 0 0, 0 20 0"><GeoOrigin DEF="O" geoCoords="0 0 0"/></GeoPositionInterpolator>
    <GeoPositionInterpolator DEF="Z"/>
  </Scene>
</X3D>
