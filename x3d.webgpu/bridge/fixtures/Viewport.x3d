<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layering" level="1"/><component name="Layout" level="1"/><component name="Navigation" level="3"/><component name="Text" level="1"/><meta name="title" content="Viewport.x3d"/><meta name="description" content="Bridge fixture for Viewport: the clip rectangle of a layer, set to the left half, the right half and the lower half of the canvas"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Viewport DEF="WV" containerField="children" visible="false" clipBoundary="0 0.5 0 1"><Transform translation="0 0 -6"><TouchSensor DEF="WT"/><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 1 0"/></Appearance><Box size="6 6 1"/></Shape></Transform></Viewport>
    <LayerSet order="0 1">
      <Layer DEF="N">
        <Viewport DEF="V" containerField="viewport" clipBoundary="0 0.5 0 1"/>
        <Transform><TouchSensor DEF="LT"/><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="8 8 8"/></Shape></Transform>
      </Layer>
    </LayerSet>
  </Scene>
</X3D>
