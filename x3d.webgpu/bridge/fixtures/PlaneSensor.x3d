<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="PlaneSensor.x3d"/><meta name="description" content="Bridge fixture for PlaneSensor: drag a box, route the sensor output to its Transform; a second box with axisRotation, a third with a line sensor (minPosition.x = maxPosition.x)"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Transform DEF="T">
      <Shape><Appearance><Material diffuseColor="0.9 0.35 0.2"/></Appearance><Box size="2 2 2"/></Shape>
      <PlaneSensor DEF="N" />
    </Transform>
    <Transform DEF="T2" translation="-3 -2.4 0">
      <Shape><Appearance><Material diffuseColor="0.2 0.6 0.9"/></Appearance><Box size="2 2 2"/></Shape>
      <PlaneSensor DEF="N2" axisRotation="0 0 1 0.5"/>
    </Transform>
    <Transform DEF="T3" translation="3 -2.4 0">
      <Shape><Appearance><Material diffuseColor="0.3 0.8 0.3"/></Appearance><Box size="2 2 2"/></Shape>
      <PlaneSensor DEF="N3" minPosition="0 -1" maxPosition="0 1"/>
    </Transform>
    <ROUTE fromNode="N" fromField="translation_changed" toNode="T" toField="set_translation"/>
    <ROUTE fromNode="N2" fromField="translation_changed" toNode="T2" toField="set_translation"/>
    <ROUTE fromNode="N3" fromField="translation_changed" toNode="T3" toField="set_translation"/>
  </Scene>
</X3D>
