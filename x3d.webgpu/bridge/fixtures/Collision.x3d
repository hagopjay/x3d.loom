<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Collision.x3d"/><meta name="description" content="Bridge fixture for Collision: a group that is drawn like a Group; a proxy is never drawn"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Collision DEF="C1" enabled="false"><Transform translation="-3 0 0"><Shape DEF="S1"><Appearance><Material diffuseColor="0.9 0.4 0.3"/></Appearance><Box size="1.6 1.6 1.6"/></Shape><TouchSensor DEF="T1"/></Transform></Collision>
    <Collision DEF="C2"><Shape containerField="proxy" DEF="PX"><Appearance><Material emissiveColor="0 1 0"/></Appearance><Sphere radius="3"/></Shape><Transform translation="0 0 0"><Shape DEF="S2"><Appearance><Material diffuseColor="0.3 0.8 0.5"/></Appearance><Sphere radius="0.9"/></Shape><TouchSensor DEF="T2"/></Transform></Collision>
    <Collision DEF="C3" bboxCenter="1 0 0" bboxSize="4 4 4"><Transform translation="3 0 0"><Shape DEF="S3"><Appearance><Material diffuseColor="0.3 0.5 0.9"/></Appearance><Cone bottomRadius="0.9" height="1.8"/></Shape><TouchSensor DEF="T3"/></Transform></Collision>
  </Scene>
</X3D>
