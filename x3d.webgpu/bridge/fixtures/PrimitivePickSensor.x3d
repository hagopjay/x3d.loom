<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Picking" level="3"/><meta name="title" content="PrimitivePickSensor.x3d"/><meta name="description" content="Bridge fixture for PrimitivePickSensor: a Box, Sphere moved through PickableGroups; sortOrder, objectType, BOUNDS and GEOMETRY"/></head>
  <Scene>
    <Viewpoint position="0 0 14"/>
    <Group DEF="WORLD">
      <PickableGroup DEF="PG">
        <Transform translation="-2 0 0"><Shape><Appearance><Material diffuseColor="0.9 0.3 0.2"/></Appearance><Box DEF="BA" size="2 2 2"/></Shape></Transform>
        <Transform translation="2 0 0"><Shape><Appearance><Material diffuseColor="0.2 0.5 0.9"/></Appearance><Sphere DEF="SB" radius="1"/></Shape></Transform>
      </PickableGroup>
      <PickableGroup DEF="PGW" objectType='"WALL"'>
        <Transform translation="0 3 0"><Shape><Appearance><Material diffuseColor="0.3 0.8 0.3"/></Appearance><Box DEF="BC" size="2 1 2"/></Shape></Transform>
      </PickableGroup>
      <PickableGroup DEF="PGOFF" pickable="false">
        <Transform translation="0 -3 0"><Shape><Appearance><Material diffuseColor="0.8 0.8 0.2"/></Appearance><Box DEF="BD" size="2 1 2"/></Shape></Transform>
      </PickableGroup>
      <Transform translation="6 -3 0"><Shape><Appearance><Material diffuseColor="0.6 0.3 0.8"/></Appearance><Box DEF="BE" size="1 1 1"/></Shape></Transform>
    </Group>
    <Transform DEF="TN" translation="-2 0 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="N" >
        <Box DEF="PB" size="1 1 1" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNA" translation="0.5 0 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NA" sortOrder="ALL">
        <Box DEF="PL" size="5 1 1" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNS" translation="0.5 0 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NS" sortOrder="ALL_SORTED">
        <Box USE="PL" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNY" translation="0.5 0 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NY" sortOrder="ANY">
        <Box USE="PL" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNC" translation="0.5 0 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NC" >
        <Box USE="PL" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNF" translation="0 3 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NF" objectType='"FLOOR"'>
        <Box USE="PB" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNW" translation="0 3 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NW" objectType='"WALL"'>
        <Box USE="PB" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNB" translation="-3.9 1.8 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NB" intersectionType="BOUNDS">
        <Sphere DEF="PS" radius="1" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
    <Transform DEF="TNG" translation="-3.9 1.8 0">
      <Shape><Box size="0.02 0.02 0.02"/></Shape>
      <PrimitivePickSensor DEF="NG" intersectionType="GEOMETRY">
        <Sphere USE="PS" containerField="pickingGeometry"/>
        <Group USE="WORLD" containerField="pickTarget"/>
      </PrimitivePickSensor>
    </Transform>
  </Scene>
</X3D>
