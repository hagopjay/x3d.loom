<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="LocalFog.x3d"/><meta name="description" content="Bridge fixture for LocalFog"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Group DEF="Foggy">
      <LocalFog DEF="N" color="1 0 0" visibilityRange="20"/>
      <Transform translation="-2.5 0 0"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 1 1"/></Appearance><Box size="2 2 2"/></Shape></Transform>
    </Group>
    <Group DEF="Clear">
      <Transform translation="2.5 0 0"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 1 1"/></Appearance><Box size="2 2 2"/></Shape></Transform>
    </Group>
  </Scene>
</X3D>
