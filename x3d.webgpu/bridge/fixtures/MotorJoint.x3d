<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="RigidBodyPhysics" level="2"/><meta name="title" content="MotorJoint.x3d"/><meta name="description" content="Bridge fixture for MotorJoint: a user torque spins a ball"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <RigidBodyCollection DEF="W" gravity="0 0 0">
      <RigidBody DEF="B1" position="0 0 0" mass="1" fixed="true" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="0.1"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="B2" position="2 0 0" mass="1" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="0.3"/></Shape></CollidableShape></RigidBody>
      <CollisionCollection containerField="collider" bounce="0"/>
      <MotorJoint containerField="joints" DEF="N" enabledAxes="1" axis1Torque="1" motor1Axis="1 0 0" forceOutput='"motor1Angle"'><RigidBody USE="B1" containerField="body1"/><RigidBody USE="B2" containerField="body2"/></MotorJoint>
    </RigidBodyCollection>
  </Scene>
</X3D>
