<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Shape" level="4"/><meta name="title" content="TwoSidedMaterial.x3d"/><meta name="description" content="Bridge fixture for TwoSidedMaterial"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Group>
      <Transform translation="-2.5 0 0"><Shape DEF="S1"><Appearance><TwoSidedMaterial DEF="T1" separateBackColor="true" diffuseColor="1 0 0" backDiffuseColor="0 0 1"/></Appearance><IndexedTriangleSet DEF="G1" index="0 1 2 0 2 3"><Coordinate point="-1 -1 0, 1 -1 0, 1 1 0, -1 1 0"/></IndexedTriangleSet></Shape></Transform>
      <Transform translation="2.5 0 0"><Shape DEF="S2"><Appearance><TwoSidedMaterial DEF="T2" diffuseColor="0 1 0" backDiffuseColor="1 1 0"/></Appearance><IndexedTriangleSet DEF="G2" index="0 1 2 0 2 3"><Coordinate point="-1 -1 0, 1 -1 0, 1 1 0, -1 1 0"/></IndexedTriangleSet></Shape></Transform>
      <TouchSensor DEF="TS"/>
    </Group>
  </Scene>
</X3D>
