<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layering" level="1"/><component name="Layout" level="1"/><component name="Navigation" level="3"/><component name="Text" level="1"/><meta name="title" content="LayoutGroup.x3d"/><meta name="description" content="Bridge fixture for LayoutGroup: a LayoutGroup with its own Layout inside the layout of a LayoutLayer, a blue box placed by both"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="2 2 2"/></Shape>
    <Group><LayoutGroup DEF="W"><Transform translation="0 0 -20"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="4 4 4"/></Shape></Transform></LayoutGroup></Group>
    <LayerSet order="0 1">
      <LayoutLayer DEF="LL">
        <Layout DEF="OUTER" align='"LEFT" "CENTER"' offsetUnits='"WORLD" "WORLD"' offset="0 0" sizeUnits='"FRACTION" "FRACTION"' size="0.5 1" scaleMode='"NONE" "NONE"'/>
        <LayoutGroup DEF="G">
          <Layout DEF="LY" align='"RIGHT" "TOP"' offsetUnits='"WORLD" "WORLD"' offset="0 0" sizeUnits='"FRACTION" "FRACTION"' size="0.5 0.5" scaleMode='"FRACTION" "FRACTION"'/>
          <Transform><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="1 1 1"/></Shape></Transform>
        </LayoutGroup>
      </LayoutLayer>
    </LayerSet>
  </Scene>
</X3D>
