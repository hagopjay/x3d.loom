<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="VolumeRendering" level="3"/><component name="Texturing3D" level="1"/><meta name="title" content="EdgeEnhancementVolumeStyle.x3d"/><meta name="description" content="Bridge fixture for EdgeEnhancementVolumeStyle: layers of voxels seen end on; the layers at the ends have no gradient and vanish"/></head>
  <Scene>
    <Background skyColor="1 1 1"/>
    <NavigationInfo headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <VolumeData dimensions="1 1 1"><PixelTexture3D DEF="T" containerField="voxels" image="1 4 4 4 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6 6"/><EdgeEnhancementVolumeStyle DEF="N" containerField="renderStyle"/></VolumeData>
  </Scene>
</X3D>
