<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="OrthoViewpoint.x3d"/><meta name="description" content="Bridge fixture for OrthoViewpoint"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="true"/>
    <OrthoViewpoint DEF="O" position="0 0 10"/>
    <Viewpoint DEF="P" position="0 0 10"/>
    <Group>
      <Shape><Appearance><Material diffuseColor="0.9 0.5 0.2"/></Appearance><Box size="2 2 2"/></Shape>
      <TouchSensor DEF="TS"/>
    </Group>
  </Scene>
</X3D>
