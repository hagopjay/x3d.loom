    <Transform translation="0 0 0"><Shape DEF="S2"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Arc2D DEF="G2" radius="1.2" startAngle="5" endAngle="1"/></Shape></Transform>
    <Transform translation="3.5 0 0"><Shape DEF="S3"><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Arc2D DEF="G3" radius="1.2" startAngle="1" endAngle="1"/></Shape></Transform>
