<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="OscillatorSource.x3d"/><meta name="description" content="Bridge fixture for OscillatorSource: tone generator, frequency, detune and the wave from a PeriodicWave"/></head>
  <Scene>
    <OscillatorSource DEF="N"/>
    <OscillatorSource DEF="O1"><PeriodicWave DEF="W1" type="SINE"/></OscillatorSource>
    <OscillatorSource DEF="O2"><PeriodicWave DEF="W2" type="TRIANGLE"/></OscillatorSource>
    <OscillatorSource DEF="O3"><PeriodicWave DEF="W3" type="SAWTOOTH"/></OscillatorSource>
    <OscillatorSource DEF="O4"><PeriodicWave DEF="W4" type="CUSTOM" optionsReal="0 1 0.5" optionsImag="0 0 0.25"/></OscillatorSource>
  </Scene>
</X3D>
