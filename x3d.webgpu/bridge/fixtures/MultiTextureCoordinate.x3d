<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="MultiTextureCoordinate.x3d"/><meta name="description" content="Bridge fixture for MultiTextureCoordinate: two texture channels with their own coordinates"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Transform translation="-2.4 0 0"><Shape DEF="S1"><Appearance><MultiTexture DEF="M1" mode='"REPLACE" "MODULATE"'><PixelTexture image="2 1 3 0xff0000 0x00ff00"/><PixelTexture image="2 1 3 0xffffff 0x0000ff"/></MultiTexture><Material diffuseColor="1 1 1"/></Appearance><IndexedFaceSet DEF="F1" coordIndex="0 1 2 3 -1" texCoordIndex="0 1 2 3 -1"><Coordinate point="-1.5 -1 0, 1.5 -1 0, 1.5 1 0, -1.5 1 0"/><MultiTextureCoordinate DEF="MT1"><TextureCoordinate point="0 0, 1 0, 1 1, 0 1"/><TextureCoordinate point="1 0, 0 0, 0 1, 1 1"/></MultiTextureCoordinate></IndexedFaceSet></Shape><TouchSensor DEF="T1"/></Transform>
    <Transform translation="2.4 0 0"><Shape DEF="S2"><Appearance><MultiTexture DEF="M2" mode='"REPLACE" "MODULATE"'><PixelTexture image="2 1 3 0xff0000 0x00ff00"/><PixelTexture image="2 1 3 0xffffff 0x0000ff"/></MultiTexture><Material diffuseColor="1 1 1"/></Appearance><IndexedFaceSet DEF="F2" coordIndex="0 1 2 3 -1" texCoordIndex="0 1 2 3 -1"><Coordinate point="-1.5 -1 0, 1.5 -1 0, 1.5 1 0, -1.5 1 0"/><MultiTextureCoordinate DEF="MT2"><TextureCoordinate point="0 0, 1 0, 1 1, 0 1"/><TextureCoordinate point="0 0, 1 0, 1 1, 0 1"/></MultiTextureCoordinate></IndexedFaceSet></Shape><TouchSensor DEF="T2"/></Transform>
  </Scene>
</X3D>
