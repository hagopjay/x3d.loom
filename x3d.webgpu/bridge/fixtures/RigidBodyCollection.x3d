<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="RigidBodyPhysics" level="2"/><meta name="title" content="RigidBodyCollection.x3d"/><meta name="description" content="Bridge fixture for RigidBodyCollection: a ball falls on a fixed ground and comes to rest; enabled false stops the world"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <RigidBodyCollection DEF="W" >
      <RigidBody DEF="G" position="0 -0.5 0" mass="1" fixed="true" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Box size="20 1 20"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="N0" position="0 5 0" mass="1" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="1"/></Shape></CollidableShape></RigidBody>
      <CollisionCollection containerField="collider" DEF="C"/>
    </RigidBodyCollection>
  </Scene>
</X3D>
