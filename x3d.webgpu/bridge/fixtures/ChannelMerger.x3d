<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Sound" level="2"/><meta name="title" content="ChannelMerger.x3d"/><meta name="description" content="Bridge fixture for ChannelMerger: two sources joined into one stereo signal, one merger input per child"/></head>
  <Scene>
    <ChannelMerger DEF="N">
      <BufferAudioSource DEF="S"/>
      <BufferAudioSource DEF="S2"/>
    </ChannelMerger>
    <ChannelMerger DEF="SM">
      <OscillatorSource DEF="SOA" frequency="440"><PeriodicWave type="SINE"/></OscillatorSource>
      <OscillatorSource DEF="SOB" frequency="880"><PeriodicWave type="SINE"/></OscillatorSource>
      <OscillatorSource DEF="SOC" frequency="1320"><PeriodicWave type="SINE"/></OscillatorSource>
    </ChannelMerger>
  </Scene>
</X3D>
