<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="RigidBodyPhysics" level="2"/><meta name="title" content="SingleAxisHingeJoint.x3d"/><meta name="description" content="Bridge fixture for SingleAxisHingeJoint: the same swinging ball, kept in a plane by a hinge about z"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <RigidBodyCollection DEF="W" >
      <RigidBody DEF="B1" position="0 5 0" mass="1" fixed="true" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="0.1"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="B2" position="2 5 0" mass="1" linearVelocity="0 0 3"><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="0.3"/></Shape></CollidableShape></RigidBody>
      <CollisionCollection containerField="collider" bounce="0"/>
      <SingleAxisHingeJoint containerField="joints" DEF="N" anchorPoint="0 5 0" axis="0 0 1" minAngle="-0.5" maxAngle="0.5" forceOutput='"angle"'><RigidBody USE="B1" containerField="body1"/><RigidBody USE="B2" containerField="body2"/></SingleAxisHingeJoint>
    </RigidBodyCollection>
  </Scene>
</X3D>
