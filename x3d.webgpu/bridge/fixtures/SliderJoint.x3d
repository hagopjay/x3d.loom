<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="RigidBodyPhysics" level="2"/><meta name="title" content="SliderJoint.x3d"/><meta name="description" content="Bridge fixture for SliderJoint: a ball slides down an axis and stops at its limit"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <RigidBodyCollection DEF="W" gravity="0 -9.8 0">
      <RigidBody DEF="B1" position="0 0 0" mass="1" fixed="true" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="0.1"/></Shape></CollidableShape></RigidBody>
      <RigidBody DEF="B2" position="0 -1 0" mass="1" ><CollidableShape containerField="geometry"><Shape containerField="shape"><Sphere radius="0.3"/></Shape></CollidableShape></RigidBody>
      <CollisionCollection containerField="collider" bounce="0"/>
      <SliderJoint containerField="joints" DEF="N" axis="0 -1 0" minSeparation="0" maxSeparation="2.5" forceOutput='"separation"'><RigidBody USE="B1" containerField="body1"/><RigidBody USE="B2" containerField="body2"/></SliderJoint>
    </RigidBodyCollection>
  </Scene>
</X3D>
