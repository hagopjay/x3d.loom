<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="SplineScalarInterpolator.x3d"/><meta name="description" content="Bridge fixture for SplineScalarInterpolator"/></head>
  <Scene>
    <SplineScalarInterpolator DEF="N" key="0 0.25 0.5 1" keyValue="0 3 1 4"/>
    <SplineScalarInterpolator DEF="Lin" key="0 0.25 0.5 0.75 1" keyValue="0 2.5 5 7.5 10"/>
    <SplineScalarInterpolator DEF="Norm" key="0 1" keyValue="0 4" keyVelocity="2 2" normalizeVelocity="true"/>
  </Scene>
</X3D>
