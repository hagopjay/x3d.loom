<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Shape' level='2'/>
    <component name='ParticleSystems' level='3'/>
    <meta name='title' content='First Light'/>
    <meta name='description' content='A gold orb over a pedestal, a turning ring of steel monoliths, a crown of glints and a fountain of embers. Touch the orb.'/>
    <meta name='generator' content='hand-written for the x3d.webgpu first-light demo'/>
  </head>
  <Scene>
    <WorldInfo title='First Light' info='"X3D 4.0 scene drawn by the x3d.webgpu first-light demo"'/>
    <NavigationInfo type='"EXAMINE" "ANY"' headlight='false'/>
    <Viewpoint DEF='Front' description='First light' position='0 2.4 8.2' orientation='1 0 0 -0.145' fieldOfView='0.75' centerOfRotation='0 1.2 0'/>
    <Background skyColor='0.004 0.007 0.025, 0.015 0.035 0.09, 0.05 0.05 0.11, 0.42 0.2 0.11' skyAngle='0.8 1.25 1.5708'
                groundColor='0.004 0.004 0.005, 0.05 0.03 0.025, 0.36 0.18 0.1' groundAngle='1.2 1.5708'/>
    <Fog color='0.36 0.18 0.1' fogType='EXPONENTIAL' visibilityRange='110'/>

    <!-- Lights. Root-level lights light the whole scene. -->
    <DirectionalLight DEF='Key' global='true' direction='-0.45 -0.8 -0.4' color='1 0.86 0.7' intensity='3.2' shadows='true'/>
    <DirectionalLight DEF='Rim' global='true' direction='0.2 -0.75 0.63' color='0.5 0.68 1' intensity='1.2'/>
    <PointLight DEF='EmberLight' location='0 2.3 0' color='1 0.5 0.18' intensity='3' attenuation='0 0 1' radius='12'/>
    <PointLight DEF='PlateLight' location='0 0.95 0' color='0.2 0.8 1' intensity='1.2' attenuation='0 0 1' radius='4'/>

    <!-- Floor: wide enough that the fog meets the sky at the horizon. -->
    <Transform translation='0 -0.05 0'>
      <Shape castShadow='false'>
        <Appearance>
          <PhysicalMaterial baseColor='0.02 0.02 0.025' metallic='0' roughness='0.42'/>
        </Appearance>
        <Cylinder radius='120' height='0.1'/>
      </Shape>
    </Transform>

    <!-- Pedestal and its glowing plate. -->
    <Transform translation='0 0.45 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.06 0.06 0.07' metallic='0.2' roughness='0.42'/>
        </Appearance>
        <Cylinder radius='0.55' height='0.9'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.915 0'>
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor='0.02 0.08 0.1' metallic='0' roughness='0.5' emissiveColor='0.1 0.75 0.95'/>
        </Appearance>
        <Cylinder radius='0.5' height='0.03'/>
      </Shape>
    </Transform>

    <!-- The orb. The TouchSensor watches its sibling geometry. -->
    <Transform DEF='Orb' translation='0 1.6 0'>
      <TouchSensor DEF='Touch' description='Touch the orb'/>
      <Shape>
        <Appearance>
          <PhysicalMaterial DEF='OrbMat' baseColor='1 0.766 0.336' metallic='1' roughness='0.16'/>
        </Appearance>
        <Sphere radius='0.5'/>
      </Shape>
    </Transform>

    <!-- Ring of twelve monoliths with lit strips: one DEF, eleven USE. -->
    <Transform DEF='Ring'>
      <Transform translation='0 0.55 2.2'>
        <Group DEF='Monolith'>
          <Shape>
            <Appearance>
              <PhysicalMaterial baseColor='0.32 0.33 0.36' metallic='1' roughness='0.3'/>
            </Appearance>
            <Box size='0.22 1.1 0.08'/>
          </Shape>
          <!-- a lit strip on the face that looks at the orb -->
          <Transform translation='0 0 -0.042'>
            <Shape castShadow='false'>
              <Appearance><UnlitMaterial emissiveColor='0.35 0.95 1'/></Appearance>
              <Box size='0.03 0.92 0.004'/>
            </Shape>
          </Transform>
        </Group>
      </Transform>
      <Transform translation='1.1 0.55 1.9053' rotation='0 1 0 0.5236'><Group USE='Monolith'/></Transform>
      <Transform translation='1.9053 0.55 1.1' rotation='0 1 0 1.0472'><Group USE='Monolith'/></Transform>
      <Transform translation='2.2 0.55 0' rotation='0 1 0 1.5708'><Group USE='Monolith'/></Transform>
      <Transform translation='1.9053 0.55 -1.1' rotation='0 1 0 2.0944'><Group USE='Monolith'/></Transform>
      <Transform translation='1.1 0.55 -1.9053' rotation='0 1 0 2.618'><Group USE='Monolith'/></Transform>
      <Transform translation='0 0.55 -2.2' rotation='0 1 0 3.1416'><Group USE='Monolith'/></Transform>
      <Transform translation='-1.1 0.55 -1.9053' rotation='0 1 0 3.6652'><Group USE='Monolith'/></Transform>
      <Transform translation='-1.9053 0.55 -1.1' rotation='0 1 0 4.1888'><Group USE='Monolith'/></Transform>
      <Transform translation='-2.2 0.55 0' rotation='0 1 0 4.7124'><Group USE='Monolith'/></Transform>
      <Transform translation='-1.9053 0.55 1.1' rotation='0 1 0 5.236'><Group USE='Monolith'/></Transform>
      <Transform translation='-1.1 0.55 1.9053' rotation='0 1 0 5.7596'><Group USE='Monolith'/></Transform>
    </Transform>

    <!-- Crown of sixteen glints, two DEFs alternating. -->
    <Transform DEF='Crown'>
      <Transform translation='0 1.3 3' rotation='0.7071 0 0.7071 0.9553'>
        <Shape DEF='GlintCool' castShadow='false'>
          <Appearance><UnlitMaterial emissiveColor='0.35 0.95 1'/></Appearance>
          <Box size='0.07 0.07 0.07'/>
        </Shape>
      </Transform>
      <Transform translation='1.1481 1.6 2.7716' rotation='0.7071 0 0.7071 0.9553'>
        <Shape DEF='GlintWarm' castShadow='false'>
          <Appearance><UnlitMaterial emissiveColor='1 0.72 0.36'/></Appearance>
          <Box size='0.07 0.07 0.07'/>
        </Shape>
      </Transform>
      <Transform translation='2.1213 1.3 2.1213' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintCool'/></Transform>
      <Transform translation='2.7716 1.6 1.1481' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintWarm'/></Transform>
      <Transform translation='3 1.3 0' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintCool'/></Transform>
      <Transform translation='2.7716 1.6 -1.1481' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintWarm'/></Transform>
      <Transform translation='2.1213 1.3 -2.1213' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintCool'/></Transform>
      <Transform translation='1.1481 1.6 -2.7716' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintWarm'/></Transform>
      <Transform translation='0 1.3 -3' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintCool'/></Transform>
      <Transform translation='-1.1481 1.6 -2.7716' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintWarm'/></Transform>
      <Transform translation='-2.1213 1.3 -2.1213' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintCool'/></Transform>
      <Transform translation='-2.7716 1.6 -1.1481' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintWarm'/></Transform>
      <Transform translation='-3 1.3 0' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintCool'/></Transform>
      <Transform translation='-2.7716 1.6 1.1481' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintWarm'/></Transform>
      <Transform translation='-2.1213 1.3 2.1213' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintCool'/></Transform>
      <Transform translation='-1.1481 1.6 2.7716' rotation='0.7071 0 0.7071 0.9553'><Shape USE='GlintWarm'/></Transform>
    </Transform>

    <!-- Ember fountain from the crown of the orb. -->
    <Transform DEF='Fountain' translation='0 2.2 0'>
      <ParticleSystem DEF='Embers' geometryType='SPRITE' maxParticles='40000' particleLifetime='2.8' lifetimeVariation='0.35'
                      particleSize='0.035 0.035' colorKey='0 0.12 1 2.4'>
        <Appearance><UnlitMaterial emissiveColor='1 1 1'/></Appearance>
        <ColorRGBA color='1 0.85 0.55 1, 1 0.45 0.08 1, 0.75 0.12 0.02 0.6, 0.2 0.02 0.01 0'/>
        <PointEmitter DEF='Spout' direction='0 1 0' speed='1.8' variation='0.4' mass='0.05' surfaceArea='0.06'/>
        <ForcePhysicsModel force='0 -0.05 0'/>
        <WindPhysicsModel direction='0.958 0 0.287' speed='0.6' gustiness='0.4' turbulence='0.55'/>
      </ParticleSystem>
    </Transform>

    <!-- Motion: one clock fans out to the ring and the crown; a slower one breathes the orb. -->
    <TimeSensor DEF='Clock' cycleInterval='40' loop='true'/>
    <OrientationInterpolator DEF='Spin' key='0 0.25 0.5 0.75 1'
        keyValue='0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832'/>
    <OrientationInterpolator DEF='CounterSpin' key='0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1'
        keyValue='0 1 0 0, 0 1 0 -1.5708, 0 1 0 -3.1416, 0 1 0 -4.7124, 0 1 0 -6.2832, 0 1 0 -7.854, 0 1 0 -9.4248, 0 1 0 -10.9956, 0 1 0 -12.5664'/>
    <TimeSensor DEF='Breath' cycleInterval='6' loop='true'/>
    <PositionInterpolator DEF='Bob' key='0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1'
        keyValue='0 1.6 0, 0 1.6424 0, 0 1.66 0, 0 1.6424 0, 0 1.6 0, 0 1.5576 0, 0 1.54 0, 0 1.5576 0, 0 1.6 0'/>

    <!-- Touch: one pulse drives the ember speed, the ember light and the orb's glow. -->
    <TimeSensor DEF='Pulse' cycleInterval='1.8'/>
    <ScalarInterpolator DEF='BurstSpeed' key='0 0.08 1' keyValue='1.8 6 1.8'/>
    <ScalarInterpolator DEF='Flash' key='0 0.06 1' keyValue='3 16 3'/>
    <ColorInterpolator DEF='Glow' key='0 0.15 1' keyValue='0 0 0, 1 0.38 0.06, 0 0 0'/>

    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Spin' toField='set_fraction'/>
    <ROUTE fromNode='Spin' fromField='value_changed' toNode='Ring' toField='set_rotation'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='CounterSpin' toField='set_fraction'/>
    <ROUTE fromNode='CounterSpin' fromField='value_changed' toNode='Crown' toField='set_rotation'/>
    <ROUTE fromNode='Breath' fromField='fraction_changed' toNode='Bob' toField='set_fraction'/>
    <ROUTE fromNode='Bob' fromField='value_changed' toNode='Orb' toField='set_translation'/>
    <ROUTE fromNode='Touch' fromField='touchTime' toNode='Pulse' toField='set_startTime'/>
    <ROUTE fromNode='Pulse' fromField='fraction_changed' toNode='BurstSpeed' toField='set_fraction'/>
    <ROUTE fromNode='BurstSpeed' fromField='value_changed' toNode='Spout' toField='set_speed'/>
    <ROUTE fromNode='Pulse' fromField='fraction_changed' toNode='Flash' toField='set_fraction'/>
    <ROUTE fromNode='Flash' fromField='value_changed' toNode='EmberLight' toField='set_intensity'/>
    <ROUTE fromNode='Pulse' fromField='fraction_changed' toNode='Glow' toField='set_fraction'/>
    <ROUTE fromNode='Glow' fromField='value_changed' toNode='OrbMat' toField='set_emissiveColor'/>
  </Scene>
</X3D>
