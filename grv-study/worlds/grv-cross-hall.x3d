    <meta name="atlas.prompt" content="A Renaissance palace hall in the shape of a Greek cross, four equal barrel-vaulted arms meeting under a high central crossing, polished cream and grey marble floor in a geometric inlay running into every arm, warm plaster walls with tall arched niches at the end of each arm, grey stone pilasters, four square stone piers at the crossing, a low round marble dais in the centre, soft daylight, architectural interior photograph, sharp focus"/>
    <meta name="atlas.grid" content="1280 720; fx = fy = 762.7223 px; cx 640, cy 360; pose camera-to-world, rub"/>
