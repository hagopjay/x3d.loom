{
  "name": "x3d-gltf-lane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "glTF tooling lane for the X3D pipeline: glTF-Transform, meshoptimizer, Draco, KTX2 and the Khronos validator, with an X3D identity gate",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node tools/build-web.mjs",
    "probe:steps": "node tools/step-probe.mjs",
    "cli": "node bin/x3dgltf.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "draco3dgltf": "1.5.9",
    "gltf-validator": "2.0.0-dev.3.10",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "babylonjs": "9.32.0",
    "babylonjs-loaders": "9.32.0",
    "esbuild": "0.25.12",
    "playcanvas": "2.24.1",
    "three": "0.187.0",
    "x_ite": "16.7.1"
  },
  "bin": {
    "x3dgltf": "bin/x3dgltf.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
