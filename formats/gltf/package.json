{
  "name": "loom-gltf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Loom, ported to glTF 2.0: Khronos validator gate, Khronos Sample Renderer reference, N engines, PSNR/SSIM score, loom.render-receipt/1",
  "scripts": {
    "corpus": "node tools/fetch-corpus.mjs",
    "run": "node bin/loom-gltf.mjs run",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@khronosgroup/gltf-viewer": "1.1.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "sharp": "0.35.5"
  },
  "engines": { "node": ">=20" }
}
