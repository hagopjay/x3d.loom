<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="FogCoordinate.x3d"/><meta name="description" content="two white unlit quads under the world Fog (red, range 20): the left one with per-vertex fog depths 0 0 1 1 (bottom clear, top fully fogged), the right one with the distance law; then the depths are set to 1 1 0 0"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Fog color="1 0 0" visibilityRange="20"/>
    <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 1 1"/></Appearance><IndexedTriangleSet index="0 1 2 0 2 3"><Coordinate point="-4 -3 0 -1 -3 0 -1 3 0 -4 3 0"/><FogCoordinate DEF="FC" containerField="fogCoord" depth="0 0 1 1"/></IndexedTriangleSet></Shape>
    <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 1 1"/></Appearance><IndexedTriangleSet index="0 1 2 0 2 3"><Coordinate point="1 -3 0 4 -3 0 4 3 0 1 3 0"/></IndexedTriangleSet></Shape>
  </Scene>
</X3D>
