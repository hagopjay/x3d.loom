    <Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><IndexedFaceSet coordIndex="0 1 2 3 -1"><GeoCoordinate DEF="GC" point="0 0 0, 0 0.00002 0, 0 0.00002 2, 0 0 2"><GeoOrigin DEF="O" geoCoords="0 0 0" rotateYUp="true"/></GeoCoordinate></IndexedFaceSet></Shape>
  </Scene>
