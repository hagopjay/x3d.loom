<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Geospatial" level="2"/><meta name="title" content="GeoOrigin.x3d"/><meta name="description" content="Bridge fixture for GeoOrigin: a red quad whose corners are geographic points (lat 0, lon 0 to 0.00002 degrees, height 0 to 2 m), drawn in the origin's east / up / south frame"/></head>
  <Scene>
