<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="ViewpointMoved.x3d"/><meta name="description" content="A Viewpoint inside a Transform that is moved after load: the camera follows its parent; a 2 m cube at the origin is drawn smaller when the Transform moves back by 6 m"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE"' transitionType='"TELEPORT"' headlight="true"/>
    <Transform DEF="T"><Viewpoint DEF="V" position="0 0 6"/></Transform>
    <Shape><Appearance><Material diffuseColor="0.8 0.3 0.2"/></Appearance><Box size="2 2 2"/></Shape>
  </Scene>
</X3D>