<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Disk2D.x3d"/><meta name="description" content="Disk2D radius 1.5 (filled) and an annulus (inner 0.6, outer 1.3)"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-2.3 0 0"><Shape><Appearance><Material diffuseColor="0.9 0.7 0.2"/></Appearance><Disk2D outerRadius="1.5"/></Shape></Transform>
    <Transform translation="2.3 0 0"><Shape><Appearance><Material diffuseColor="0.3 0.8 0.5"/></Appearance><Disk2D innerRadius="0.6" outerRadius="1.3"/></Shape></Transform>
  </Scene>
</X3D>
