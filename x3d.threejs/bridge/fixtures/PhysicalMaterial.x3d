<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="PhysicalMaterial.x3d"/><meta name="description" content="PhysicalMaterial (glTF metallic-roughness): a rough dielectric, a smooth metal, and an emissive one, no environment"/></head>
