    <Transform translation="-3 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.8 0.2 0.2" metallic="0" roughness="0.6"/></Appearance><Sphere radius="1.1"/></Shape></Transform>
    <Transform translation="0 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.9 0.8 0.3" metallic="1" roughness="0.3"/></Appearance><Sphere radius="1.1"/></Shape></Transform>
    <Transform translation="3 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.2 0.4 0.8" metallic="0" roughness="0.2" emissiveColor="0.3 0.1 0.0"/></Appearance><Sphere radius="1.1"/></Shape></Transform>
  </Scene>
