<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Sphere.x3d"/><meta name="description" content="a lit sphere with a specular highlight, and a second sphere with emissive colour and 50 percent transparency in front of a box"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-1.6 0 0"><Shape><Appearance><Material diffuseColor="0.9 0.4 0.2" specularColor="0.8 0.8 0.8" shininess="0.6"/></Appearance><Sphere radius="1.4"/></Shape></Transform>
    <Transform translation="1.8 0 -1"><Shape><Appearance><Material diffuseColor="0.2 0.8 0.3" /></Appearance><Box size="1.6 1.6 1.6"/></Shape></Transform>
    <Transform translation="1.2 0 1"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.2" emissiveColor="0.1 0.1 0" transparency="0.5"/></Appearance><Sphere radius="1"/></Shape></Transform>
  </Scene>
</X3D>
