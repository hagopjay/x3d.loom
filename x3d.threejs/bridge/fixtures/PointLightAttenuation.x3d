<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="PointLightAttenuation.x3d"/><meta name="description" content="a point light with attenuation 1 0 0.05 over three spheres at different distances: the fit three.js allows (d^-decay) against X_ITE's polynomial"/></head>
  <Scene>
    <NavigationInfo headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <PointLight location="0 0 4" attenuation="1 0 0.08" radius="40"/>
    <Transform translation="-4 0 0"><Shape><Appearance><Material diffuseColor="0.8 0.8 0.8" /></Appearance><Sphere radius="1"/></Shape></Transform>
    <Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0.8 0.8 0.8" /></Appearance><Sphere radius="1.4"/></Shape></Transform>
    <Transform translation="4 0 -9"><Shape><Appearance><Material diffuseColor="0.8 0.8 0.8" /></Appearance><Sphere radius="2"/></Shape></Transform>
  </Scene>
</X3D>
