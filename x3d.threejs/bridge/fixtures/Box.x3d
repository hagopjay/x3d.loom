<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Box.x3d"/><meta name="description" content="a lit box turned to show three faces: the headlight, Material colours, solid=true back-face culling and the Box geometry"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform rotation="1 1 0 0.6"><Shape><Appearance><Material diffuseColor="0.2 0.5 0.9" specularColor="0.5 0.5 0.5" shininess="0.3"/></Appearance><Box size="2.4 2 1.6"/></Shape></Transform>
  </Scene>
</X3D>
