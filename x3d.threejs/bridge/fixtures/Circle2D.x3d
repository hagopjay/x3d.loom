<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Circle2D.x3d"/><meta name="description" content="Circle2D radius 1.3 and a small one"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-2 0 0"><Shape><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Circle2D radius="1.3"/></Shape></Transform>
    <Transform translation="2 0 0"><Shape><Appearance><Material emissiveColor="0.5 1 0.6"/></Appearance><Circle2D radius="0.6"/></Shape></Transform>
  </Scene>
</X3D>
