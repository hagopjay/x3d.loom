<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="TextureProperties.x3d"/><meta name="description" content="a 4 x 4 texture and a 32 x 32 one on boxes and quads: NEAREST_PIXEL magnification, no TextureProperties (hard texels under 16 x 16), CLAMP_TO_EDGE past 1, TextureProperties with its defaults, MIRRORED_REPEAT, and a 32 x 32 image with NICEST + mipmaps"/></head>
  <Scene>
    <Viewpoint position="0 -1 14"/>
    <Transform translation="-6 2 0"><Shape><Appearance><Material diffuseColor="1 1 1"/><ImageTexture url='"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAAECAIAAAAmkwkpAAAAF0lEQVR4nGP4bwME/yEkA5wFJBlwygAAYbIXcek2N00AAAAASUVORK5CYII="'><TextureProperties magnificationFilter="NEAREST_PIXEL" minificationFilter="NEAREST_PIXEL" generateMipMaps="false"/></ImageTexture></Appearance><Box size="2 2 2"/></Shape></Transform>
