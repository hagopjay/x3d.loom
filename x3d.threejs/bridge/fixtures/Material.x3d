<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Material.x3d"/><meta name="description" content="specular, emissive and transparency of Material, and a PhysicalMaterial sphere (metallic 1, roughness 0.3, glTF model)"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-2.4 0 0"><Shape><Appearance><Material diffuseColor="0.3 0.3 0.8" specularColor="1 1 1" shininess="0.8"/></Appearance><Sphere radius="1.1"/></Shape></Transform>
    <Transform translation="0 0 0"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0.9 0.5 0.1"/></Appearance><Sphere radius="1.1"/></Shape></Transform>
    <Transform translation="2.4 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.9 0.7 0.3" metallic="1" roughness="0.3"/></Appearance><Sphere radius="1.1"/></Shape></Transform>
  </Scene>
</X3D>
