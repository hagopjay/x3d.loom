    <Transform translation="-3 0 0"><Shape><Appearance><Material diffuseColor="0.7 0.7 0.7"/></Appearance><IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1"><Coordinate point="-1 -1 0  1 -1 0  1 1 0  -1 1 0"/></IndexedFaceSet></Shape></Transform>
    <Transform translation="0 0 0"><Billboard axisOfRotation="0 1 0"><Shape><Appearance><Material diffuseColor="0.9 0.6 0.2"/></Appearance><IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1"><Coordinate point="-1 -1 0  1 -1 0  1 1 0  -1 1 0"/></IndexedFaceSet></Shape></Billboard></Transform>
    <Transform translation="3 0 0"><Billboard axisOfRotation="0 0 0"><Shape><Appearance><Material diffuseColor="0.3 0.7 0.9"/></Appearance><IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1"><Coordinate point="-1 -1 0  1 -1 0  1 1 0  -1 1 0"/></IndexedFaceSet></Shape></Billboard></Transform>
