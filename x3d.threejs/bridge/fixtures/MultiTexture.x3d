  <head><meta name="title" content="MultiTexture.x3d"/><meta name="description" content="three boxes with a MultiTexture (checker then stripes): REPLACE + MODULATE, REPLACE + ADD, and MODULATE + MODULATE2X"/></head>
  <Scene>
    <Viewpoint position="0 0 9"/>
