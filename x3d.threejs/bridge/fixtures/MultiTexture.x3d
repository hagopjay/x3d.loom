    <Transform translation="0 0 0" rotation="0 1 0 0.5"><Shape><Appearance><Material diffuseColor="1 1 1"/><MultiTexture mode='"REPLACE" "ADD"'><ImageTexture url='"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAJUlEQVR4nGN4FqABR7+enYAjXOIMg1ADMYqQxQejhkEYrCMxHgBBSwMfmYbp2gAAAABJRU5ErkJggg=="'/><ImageTexture url='"data:image/png;base64,"'/></MultiTexture></Appearance><Box size="2 2 2"/></Shape></Transform>
    <Transform translation="3 0 0" rotation="0 1 0 0.5"><Shape><Appearance><Material diffuseColor="1 1 1"/><MultiTexture mode='"MODULATE" "MODULATE2X"'><ImageTexture url='"data:image/png;base64,"'/><ImageTexture url='"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAHElEQVR4nGM4ceI/ENnYVAARMWyGUQ2jGoavBgCcUb+QiBBIAwAAAABJRU5ErkJggg=="'/></MultiTexture></Appearance><Box size="2 2 2"/></Shape></Transform>
  </Scene>
