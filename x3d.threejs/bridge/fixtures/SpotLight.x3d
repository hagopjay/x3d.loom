<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="SpotLight.x3d"/><meta name="description" content="a spot light: full intensity inside beamWidth, a linear ramp to nothing at cutOffAngle, then the cone is widened through the SAI"/></head>
  <Scene>
    <NavigationInfo headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <SpotLight DEF="SP" location="0 0 7" direction="0 0 -1" beamWidth="0.25" cutOffAngle="0.5" radius="40"/>
    <Transform translation="0 0 -1"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9" /></Appearance><Box size="12 9 0.2"/></Shape></Transform>
  </Scene>
</X3D>
