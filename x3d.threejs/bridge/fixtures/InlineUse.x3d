<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="InlineUse.x3d"/><meta name="description" content="one Inline file used twice (DEF and USE): both copies draw, load FALSE takes both away, load TRUE brings both back"/></head>
  <Scene>
    <Viewpoint position="0 0 12"/>
    <Transform translation="-3 0 0"><Inline DEF="IN" url='"data:model/x3d+xml;base64,"'/></Transform>
    <Transform translation="3 0 0" scale="0.7 0.7 0.7"><Inline USE="IN"/></Transform>
  </Scene>
</X3D>
