<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Polypoint2D.x3d"/><meta name="description" content="Polypoint2D: a ring of 12 points in the XY plane and a line of 5, drawn as points"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Shape><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Polypoint2D point="-3 1  -2 1.5  -1 1  0 1.5  1 1  2 1.5  3 1  -3 -1  -1 -1  1 -1  3 -1  0 -2"/></Shape>
  </Scene>
</X3D>
