<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Cone.x3d"/><meta name="description" content="a cone with its bottom cap, and an open cone (bottom=false) whose inside shows because solid=false"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-2 0 0" rotation="1 0 0 -0.5"><Shape><Appearance><Material diffuseColor="0.8 0.3 0.6" /></Appearance><Cone bottomRadius="1.2" height="2.4"/></Shape></Transform>
    <Transform translation="2 0 0" rotation="1 0 0 2.2"><Shape><Appearance><Material diffuseColor="0.3 0.7 0.7" /></Appearance><Cone bottomRadius="1.2" height="2.4" bottom="false" solid="false"/></Shape></Transform>
  </Scene>
</X3D>
