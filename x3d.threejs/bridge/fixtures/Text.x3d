<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Text.x3d"/><meta name="description" content="Text with a FontStyle: SERIF (default), SANS BOLD, TYPEWRITER, a two-line string with spacing 1.5 justified MIDDLE, and ITALIC SANS; marker boxes at the origins show the justification anchor"/></head>
  <Scene>
    <Viewpoint position="0 0 12"/>
    <Transform translation="-5 3 0"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Text string='"Hello X3D"'><FontStyle /></Text></Shape></Transform>
    <Transform translation="-0.5 3 0"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Text string='"Sans Bold"'><FontStyle family='"SANS"' style="BOLD"/></Text></Shape></Transform>
    <Transform translation="-5 1 0"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Text string='"Typewriter 123"'><FontStyle family='"TYPEWRITER"'/></Text></Shape></Transform>
    <Transform translation="2 0.5 0"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Text string='"two" "lines"'><FontStyle justify='"MIDDLE" "MIDDLE"' spacing="1.5"/></Text></Shape></Transform>
    <Transform translation="-5 -1.5 0"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Text string='"Italic sans"'><FontStyle family='"SANS"' style="ITALIC" size="0.8"/></Text></Shape></Transform>
    <Transform translation="-5 -3 0"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Text string='"END end"'><FontStyle justify='"END" "FIRST"'/></Text></Shape></Transform>
    <Transform translation="2.5 -3 0"><Shape><Appearance><Material diffuseColor="0.9 0.9 0.9"/></Appearance><Text string='"BEGIN minor"'><FontStyle justify='"BEGIN" "BEGIN"' size="0.7"/></Text></Shape></Transform>
  </Scene>
</X3D>
