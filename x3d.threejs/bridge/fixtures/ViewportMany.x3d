<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layering" level="1"/><meta name="title" content="ViewportMany.x3d"/><meta name="description" content="Bridge fixture for Viewport: ten Viewports in the world, one tile each, every one with a colour of its own"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <Viewport clipBoundary="0.0 0.1 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.1 0.2 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 1 0"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.2 0.3 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.3 0.4 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 1 0"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.4 0.5 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.5 0.6 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 1 0"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.6 0.7 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.7 0.8 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 1 0"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.8 0.9 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
    <Viewport clipBoundary="0.9 1.0 0 1" containerField="children"><Transform translation="0 0 -4"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 1 0"/></Appearance><Box size="12 12 1"/></Shape></Transform></Viewport>
  </Scene>
</X3D>
