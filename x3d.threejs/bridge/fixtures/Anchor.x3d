<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Anchor.x3d"/><meta name="description" content="an Anchor around a sphere and a Collision group around a box and a StaticGroup around a cone: all three are plain groups for drawing"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Anchor url='"#nowhere"' description="a link"><Transform translation="-3 0 0"><Shape><Appearance><Material diffuseColor="0.9 0.5 0.3"/></Appearance><Sphere radius="1"/></Shape></Transform></Anchor>
    <Collision enabled="true"><Transform translation="0 0 0"><Shape><Appearance><Material diffuseColor="0.4 0.7 0.9"/></Appearance><Box size="1.6 1.6 1.6"/></Shape></Transform></Collision>
    <StaticGroup><Transform translation="3 -1 0"><Shape><Appearance><Material diffuseColor="0.5 0.9 0.4"/></Appearance><Cone bottomRadius="1" height="2"/></Shape></Transform></StaticGroup>
  </Scene>
</X3D>
