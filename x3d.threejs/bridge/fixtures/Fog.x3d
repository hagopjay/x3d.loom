<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Fog.x3d"/><meta name="description" content="a row of spheres going away from the viewer in LINEAR fog, then EXPONENTIAL, then the fog is removed (visibilityRange 0)"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
    <Background skyColor="0.35 0.4 0.5"/>
    <Fog DEF="F" color="0.35 0.4 0.5" fogType="LINEAR" visibilityRange="22"/>
    <Transform translation="-3.5 0 3"><Shape><Appearance><Material diffuseColor="0.9 0.35 0.2" /></Appearance><Sphere radius="0.9"/></Shape></Transform>
    <Transform translation="-1.7 0 -2"><Shape><Appearance><Material diffuseColor="0.9 0.35 0.2" /></Appearance><Sphere radius="0.9"/></Shape></Transform>
    <Transform translation="0 0 -7"><Shape><Appearance><Material diffuseColor="0.9 0.35 0.2" /></Appearance><Sphere radius="0.9"/></Shape></Transform>
    <Transform translation="1.7 0 -12"><Shape><Appearance><Material diffuseColor="0.9 0.35 0.2" /></Appearance><Sphere radius="0.9"/></Shape></Transform>
    <Transform translation="3.5 0 -17"><Shape><Appearance><Material diffuseColor="0.9 0.35 0.2" /></Appearance><Sphere radius="0.9"/></Shape></Transform>
    <Transform translation="5 0 -22"><Shape><Appearance><Material diffuseColor="0.9 0.35 0.2" /></Appearance><Sphere radius="0.9"/></Shape></Transform>
  </Scene>
</X3D>
