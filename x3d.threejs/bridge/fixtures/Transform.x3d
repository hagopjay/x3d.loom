<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Transform.x3d"/><meta name="description" content="a Transform with a scale orientation: a non-uniform scale turned by scaleOrientation shears the box, then the box is moved by an event"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform DEF="T" translation="0 -0.5 0" rotation="0 1 0 0.4" scale="2 0.8 1" scaleOrientation="0 0 1 0.7"><Shape><Appearance><Material diffuseColor="0.4 0.6 0.9" /></Appearance><Box size="1.5 1.5 1.5"/></Shape></Transform>
  </Scene>
</X3D>
