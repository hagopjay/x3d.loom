<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="FillProperties.x3d"/><meta name="description" content="FillProperties on three shapes: default (filled), filled FALSE, and hatched TRUE with hatchStyle 1 (horizontal lines) in a hatch colour"/></head>
  <Scene>
    <Viewpoint position="0 0 9"/>
    <Transform translation="-3.2 0 0" rotation="1 1 0 0.5"><Shape><Appearance><Material diffuseColor="0.9 0.5 0.2"/><FillProperties filled="true" hatched="false"/></Appearance><Box size="2 2 2"/></Shape></Transform>
    <Transform translation="0 0 0" rotation="1 1 0 0.5"><Shape><Appearance><Material diffuseColor="0.4 0.7 0.9"/><FillProperties filled="false" hatched="false"/></Appearance><Box size="2 2 2"/></Shape></Transform>
    <Transform translation="3.2 0 0" rotation="1 1 0 0.5"><Shape><Appearance><Material diffuseColor="0.5 0.9 0.4"/><FillProperties filled="true" hatched="true" hatchStyle="1" hatchColor="1 0 0"/></Appearance><Box size="2 2 2"/></Shape></Transform>
  </Scene>
</X3D>
