<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="UnlitMaterial.x3d"/><meta name="description" content="UnlitMaterial: an unlit emissive colour (no shading) and one with transparency"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-2 0 0"><Shape><Appearance><UnlitMaterial emissiveColor="0.9 0.5 0.2"/></Appearance><Sphere radius="1.3"/></Shape></Transform>
    <Transform translation="2 0 0"><Shape><Appearance><UnlitMaterial emissiveColor="0.3 0.7 0.9" transparency="0.5"/></Appearance><Box size="2 2 2"/></Shape></Transform>
  </Scene>
</X3D>
