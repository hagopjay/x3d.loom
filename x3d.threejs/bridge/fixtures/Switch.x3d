<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Switch.x3d"/><meta name="description" content="a Switch with three children: whichChoice picks one, set through the SAI, -1 hides all"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Switch DEF="S" whichChoice="0"><Shape><Appearance><Material diffuseColor="0.9 0.3 0.3" /></Appearance><Box size="2 2 2"/></Shape><Shape><Appearance><Material diffuseColor="0.3 0.9 0.3" /></Appearance><Sphere radius="1.3"/></Shape><Shape><Appearance><Material diffuseColor="0.3 0.3 0.9" /></Appearance><Cone bottomRadius="1.2" height="2.4"/></Shape></Switch>
  </Scene>
</X3D>
