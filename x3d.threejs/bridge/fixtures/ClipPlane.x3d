<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="ClipPlane.x3d"/><meta name="description" content="a sphere and a box inside a Group with a ClipPlane (plane 0 1 0 0.3: keeps y >= -0.3), then the plane tilted, then disabled; a second sphere outside the group is not clipped"/></head>
  <Scene>
    <Viewpoint position="0 0 9"/>
    <Group><ClipPlane DEF="C" plane="0 1 0 0.3"/><Transform translation="-2 0 0"><Shape><Appearance><Material diffuseColor="0.9 0.5 0.2"/></Appearance><Sphere radius="1.3"/></Shape></Transform><Transform translation="2 0 0"><Shape><Appearance><Material diffuseColor="0.3 0.6 0.9"/></Appearance><Box size="2 2 2"/></Shape></Transform></Group>
    <Transform translation="0 -2.6 0"><Shape><Appearance><Material diffuseColor="0.5 0.9 0.5"/></Appearance><Sphere radius="0.6"/></Shape></Transform>
  </Scene>
</X3D>
