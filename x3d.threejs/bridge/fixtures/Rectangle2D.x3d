<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Rectangle2D.x3d"/><meta name="description" content="Rectangle2D size 2 x 1 (filled, in the XY plane) and a larger solid one with a Material"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-2.5 0 0"><Shape><Appearance><Material diffuseColor="0.9 0.4 0.4"/></Appearance><Rectangle2D size="2 1"/></Shape></Transform>
    <Transform translation="1.5 0 0" rotation="0 1 0 0.8"><Shape><Appearance><Material diffuseColor="0.4 0.6 0.9"/></Appearance><Rectangle2D size="3 2" solid="false"/></Shape></Transform>
  </Scene>
</X3D>
