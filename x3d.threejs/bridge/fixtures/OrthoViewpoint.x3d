<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="OrthoViewpoint.x3d"/><meta name="description" content="an OrthoViewpoint bound first: a row of three boxes at different depths, drawn without perspective (equal size); then the perspective Viewpoint is bound"/></head>
  <Scene>
    <OrthoViewpoint DEF="O" position="0 0 10" fieldOfView="-4 -3 4 3"/>
    <Viewpoint DEF="P" position="0 0 10"/>
    <Transform translation="-2.5 0 3"><Shape><Appearance><Material diffuseColor="0.9 0.5 0.2"/></Appearance><Box size="1.5 1.5 1.5"/></Shape></Transform>
    <Transform translation="0 0 -2"><Shape><Appearance><Material diffuseColor="0.4 0.7 0.9"/></Appearance><Box size="1.5 1.5 1.5"/></Shape></Transform>
    <Transform translation="2.5 0 -8"><Shape><Appearance><Material diffuseColor="0.5 0.9 0.4"/></Appearance><Box size="1.5 1.5 1.5"/></Shape></Transform>
  </Scene>
</X3D>
