<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Arc2D.x3d"/><meta name="description" content="Arc2D: a quarter arc, a three-quarter arc and a full turn (start = end), drawn as lines"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-3 0 0"><Shape><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Arc2D radius="1.2" startAngle="0" endAngle="1.5708"/></Shape></Transform>
    <Transform translation="0 0 0"><Shape><Appearance><Material emissiveColor="0.4 1 0.5"/></Appearance><Arc2D radius="1.2" startAngle="0" endAngle="4.7124"/></Shape></Transform>
    <Transform translation="3 0 0"><Shape><Appearance><Material emissiveColor="0.5 0.7 1"/></Appearance><Arc2D radius="1.2" startAngle="0" endAngle="0"/></Shape></Transform>
  </Scene>
</X3D>
