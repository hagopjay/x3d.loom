<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="LineProperties.x3d"/><meta name="description" content="three polylines with LineProperties: linewidthScaleFactor 1 (default), 4 and applied FALSE with 4"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Shape><Appearance><Material emissiveColor="1 0.8 0.2"/><LineProperties linewidthScaleFactor="1"/></Appearance><IndexedLineSet coordIndex="0 1 2 -1"><Coordinate point="-3.5 1.5 0  -2 2.5 0  -0.5 1.5 0"/></IndexedLineSet></Shape>
    <Shape><Appearance><Material emissiveColor="0.4 1 0.5"/><LineProperties linewidthScaleFactor="4"/></Appearance><IndexedLineSet coordIndex="0 1 2 -1"><Coordinate point="-3.5 -0.5 0  -2 0.5 0  -0.5 -0.5 0"/></IndexedLineSet></Shape>
    <Shape><Appearance><Material emissiveColor="0.5 0.7 1"/><LineProperties linewidthScaleFactor="4" applied="false"/></Appearance><IndexedLineSet coordIndex="0 1 2 -1"><Coordinate point="1 -0.5 0  2.5 0.5 0  4 -0.5 0"/></IndexedLineSet></Shape>
  </Scene>
</X3D>
