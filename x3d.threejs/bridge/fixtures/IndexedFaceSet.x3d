<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="IndexedFaceSet.x3d"/><meta name="description" content="a flat-shaded pyramid from an IndexedFaceSet (quad base, four triangles, ccw), with per-vertex colours on a second copy"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Transform translation="-2 -1 0" rotation="0 1 0 0.6"><Shape><Appearance><Material diffuseColor="0.8 0.8 0.8"/></Appearance>
      <IndexedFaceSet coordIndex="0 3 2 1 -1 0 1 4 -1 1 2 4 -1 2 3 4 -1 3 0 4 -1" solid="true"><Coordinate point="-1 0 -1 1 0 -1 1 0 1 -1 0 1 0 2 0"/></IndexedFaceSet></Shape></Transform>
    <Transform translation="2 -1 0" rotation="0 1 0 0.6"><Shape><Appearance><Material diffuseColor="1 1 1"/></Appearance>
