<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="Layering" level="1"/><meta name="title" content="LayerPress.x3d"/><meta name="description" content="Bridge fixture for LayerSet: a TouchSensor held in a lower layer stays over while the pointer is above a shape of a higher layer"/></head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' transitionType='"TELEPORT"' headlight="false"/>
    <Viewpoint position="0 0 10"/>
    <LayerSet DEF="N" order="0 1 2">
      <Layer DEF="L1">
        <Viewpoint position="0 0 10"/>
        <Transform><TouchSensor DEF="TS"/><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="0 0 1"/></Appearance><Box size="2 2 2"/></Shape></Transform>
      </Layer>
      <Layer DEF="L2">
        <Viewpoint position="0 0 10"/>
        <Transform translation="1 0 0"><Shape><Appearance><Material diffuseColor="0 0 0" emissiveColor="1 0 0"/></Appearance><Box size="2 2 2"/></Shape></Transform>
      </Layer>
    </LayerSet>
  </Scene>
</X3D>
