<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><component name="ParticleSystems" level="2"/><meta name="title" content="ParticleSystem.x3d"/><meta name="description" content="Bridge fixture for ParticleSystem: a cone of particles thrown up and drifting out of the picture"/></head>
  <Scene>
    <Viewpoint position="0 1 8"/>
    <ParticleSystem DEF="PS" maxParticles="400" particleLifetime="3" lifetimeVariation="0.0" geometryType="QUAD" particleSize="0.1 0.1">
      <Appearance><Material emissiveColor="1 1 1"/></Appearance>
      <ConeEmitter DEF="E" speed="1.2" variation="0" direction="0 1 0" angle="0.3" position="0 -1.5 0"/>
    </ParticleSystem>
  </Scene>
</X3D>
