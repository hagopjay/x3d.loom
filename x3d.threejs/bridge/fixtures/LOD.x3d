<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="LOD.x3d"/><meta name="description" content="a LOD with range 4 9: a sphere (near), a box (middle), a cone (far); the Viewpoint is moved through the three distances"/></head>
  <Scene>
    <Viewpoint DEF="V" position="0 0 3"/>
    <LOD range="4 9"><Shape><Appearance><Material diffuseColor="0.9 0.4 0.4"/></Appearance><Sphere radius="1"/></Shape><Shape><Appearance><Material diffuseColor="0.4 0.9 0.4"/></Appearance><Box size="1.6 1.6 1.6"/></Shape><Shape><Appearance><Material diffuseColor="0.4 0.4 0.9"/></Appearance><Cone bottomRadius="1" height="2"/></Shape></LOD>
  </Scene>
</X3D>
