<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Viewpoint.x3d"/><meta name="description" content="fieldOfView, position and orientation of a Viewpoint, and a second Viewpoint bound through set_bind"/></head>
  <Scene>
    <Viewpoint DEF="V1" position="0 0 9" fieldOfView="0.6"/>
    <Viewpoint DEF="V2" position="5 3 6" orientation="-0.4 1 0.2 0.7" fieldOfView="0.9"/>
    <Shape><Appearance><Material diffuseColor="0.8 0.5 0.2" /></Appearance><Box size="2 2 2"/></Shape>
    <Transform translation="3 0 0"><Shape><Appearance><Material diffuseColor="0.2 0.6 0.8" /></Appearance><Sphere radius="1"/></Shape></Transform>
  </Scene>
</X3D>
