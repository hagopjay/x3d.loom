<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Inline.x3d"/><meta name="description" content="three Inlines of the same small scene (an orange box with a sphere on it): one loaded at once, one under a Transform that moves and scales it, and one with load FALSE that is switched on by an event"/></head>
  <Scene>
    <Viewpoint position="0 0 12"/>
    <Transform translation="-4.5 0 0"><Inline url='"data:model/x3d+xml;base64,"'/></Transform>
    <Transform translation="0 -0.5 0" scale="0.6 0.6 0.6" rotation="0 1 0 0.6"><Inline url='"data:model/x3d+xml;base64,"'/></Transform>
    <Transform translation="4.5 0 0"><Inline DEF="IN" load="false" url='"data:model/x3d+xml;base64,"'/></Transform>
  </Scene>
</X3D>
