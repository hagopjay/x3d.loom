<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="Polyline2D.x3d"/><meta name="description" content="Polyline2D: a zig-zag in the XY plane"/></head>
  <Scene>
    <Viewpoint position="0 0 8"/>
    <Shape><Appearance><Material emissiveColor="1 0.8 0.2"/></Appearance><Polyline2D lineSegments="-3 -1  -2 1  -1 -1  0 1  1 -1  2 1  3 -1"/></Shape>
  </Scene>
</X3D>
