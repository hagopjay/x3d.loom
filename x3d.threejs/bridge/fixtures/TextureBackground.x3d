<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="TextureBackground.x3d"/><meta name="description" content="the six faces of a TextureBackground (3 x 3 PixelTextures with a white bottom-left pixel and a black top-right one, so the turn of every image shows), seen in the six directions"/></head>
  <Scene>
    <TextureBackground DEF="B" skyColor="0.3 0.3 0.3"><PixelTexture containerField="frontTexture" image="3 3 3 0xFFFFFF 0xC03030 0xC03030 0xC03030 0x808080 0xC03030 0xC03030 0xC03030 0x000000" repeatS="false" repeatT="false"/><PixelTexture containerField="backTexture" image="3 3 3 0xFFFFFF 0x30C030 0x30C030 0x30C030 0x808080 0x30C030 0x30C030 0x30C030 0x000000" repeatS="false" repeatT="false"/><PixelTexture containerField="leftTexture" image="3 3 3 0xFFFFFF 0x3030C0 0x3030C0 0x3030C0 0x808080 0x3030C0 0x3030C0 0x3030C0 0x000000" repeatS="false" repeatT="false"/><PixelTexture containerField="rightTexture" image="3 3 3 0xFFFFFF 0xC0C030 0xC0C030 0xC0C030 0x808080 0xC0C030 0xC0C030 0xC0C030 0x000000" repeatS="false" repeatT="false"/><PixelTexture containerField="topTexture" image="3 3 3 0xFFFFFF 0x30C0C0 0x30C0C0 0x30C0C0 0x808080 0x30C0C0 0x30C0C0 0x30C0C0 0x000000" repeatS="false" repeatT="false"/><PixelTexture containerField="bottomTexture" image="3 3 3 0xFFFFFF 0xC030C0 0xC030C0 0xC030C0 0x808080 0xC030C0 0xC030C0 0xC030C0 0x000000" repeatS="false" repeatT="false"/></TextureBackground>
    <Viewpoint DEF="VP" position="0 0 5"/>
  </Scene>
</X3D>
