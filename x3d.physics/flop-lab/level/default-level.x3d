  <MetadataString containerField='value' name='sign_feel' value='"label" "x=3" "y=7.2" "title=HALL 0 · FEEL" "text=Run, jump, wall-jump. Press F to go limp: you become eleven bodies and ten hinges."'/>
  <MetadataString containerField='value' name='cp_contact' value='"checkpoint" "x=17" "y=0" "name=1 Contact"'/>
  <MetadataString containerField='value' name='sign_contact' value='"label" "x=22" "y=7.2" "title=HALL 1 · CONTACT" "text=Dominoes are boxes that only push. Friction is capped at mu times the push."'/>
  <MetadataString containerField='value' name='cp_joints' value='"checkpoint" "x=51" "y=-3" "name=2 Joints"'/>
  <MetadataString containerField='value' name='sign_joints' value='"label" "x=56" "y=4.2" "title=HALL 2 · JOINTS" "text=A hinge pins two points together. Chains, bridges and you are made of them. Hold Shift near a ring."'/>
  <MetadataString containerField='value' name='cp_soft' value='"checkpoint" "x=78" "y=-3" "name=3 Compliance"'/>
  <MetadataString containerField='value' name='sign_soft' value='"label" "x=83" "y=4.2" "title=HALL 3 · COMPLIANCE" "text=Same lattice twice. Only the spring compliance differs, by 100 times."'/>
  <MetadataString containerField='value' name='cp_fields' value='"checkpoint" "x=93" "y=-3" "name=4 Fields"'/>
  <MetadataString containerField='value' name='sign_fields' value='"label" "x=98" "y=4.2" "title=HALL 4 · FIELDS" "text=Wind and water are forces over a region. Upright you are too heavy for the fan. Limp, you fly."'/>
  <MetadataString containerField='value' name='cp_broad' value='"checkpoint" "x=117" "y=-3" "name=5 Broad phase"'/>
