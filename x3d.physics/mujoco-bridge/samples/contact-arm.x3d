<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Interactive" version="4.0">
<head><unit category="length" name="metre" conversionFactor="1"/><unit category="angle" name="radian" conversionFactor="1"/><unit category="mass" name="kilogram" conversionFactor="1"/><meta name="title" content="X3D ↔ MuJoCo · Authorable contact arm"/><meta name="description" content="Experimental contact-arm/1 bridge. Standard X3D visual snapshot and drag interactions; external MuJoCo authority when attached."/></head>
<Scene>
 <WorldInfo title="Contact arm · portable experiment" info='"Drag cyan target to command. Drag orange obstacle to stage a physical edit. A bridge host is needed to simulate." "Physical metadata uses contact-arm/1, an application profile, not an ISO X3D profile."'>
 <MetadataSet DEF="BridgeContract" containerField="metadata" name="x3d-mujoco/0.1">
  <MetadataString DEF="BridgeManifest" containerField="value" name="manifest" value="&quot;{\&quot;protocol\&quot;:\&quot;x3d-mujoco/0.1\&quot;,\&quot;profile\&quot;:\&quot;contact-arm/1\&quot;,\&quot;recipe\&quot;:{\&quot;profile\&quot;:\&quot;contact-arm/1\&quot;,\&quot;upperLength\&quot;:0.55,\&quot;lowerLength\&quot;:0.45,\&quot;upperMass\&quot;:0.65,\&quot;lowerMass\&quot;:0.4,\&quot;obstacle\&quot;:{\&quot;position\&quot;:[0.88,0.56,0.34],\&quot;radius\&quot;:0.11}},\&quot;target\&quot;:[0.35,0.6],\&quot;authority\&quot;:{\&quot;dynamics\&quot;:\&quot;MuJoCo\&quot;,\&quot;presentation\&quot;:\&quot;X3D\&quot;,\&quot;modelEdits\&quot;:\&quot;explicit recipe recompilation\&quot;},\&quot;coordinates\&quot;:{\&quot;mujoco\&quot;:\&quot;Z-up metres, wxyz quaternions\&quot;,\&quot;x3d\&quot;:\&quot;Y-up metres, axis-angle rotations\&quot;,\&quot;basis\&quot;:\&quot;(x,y,z)_M → (x,z,-y)_X\&quot;},\&quot;bindings\&quot;:[{\&quot;id\&quot;:\&quot;arm.upper\&quot;,\&quot;def\&quot;:\&quot;BodyUpper\&quot;,\&quot;mj\&quot;:\&quot;upper\&quot;,\&quot;authority\&quot;:\&quot;MuJoCo\&quot;,\&quot;role\&quot;:\&quot;body\&quot;},{\&quot;id\&quot;:\&quot;arm.lower\&quot;,\&quot;def\&quot;:\&quot;BodyLower\&quot;,\&quot;mj\&quot;:\&quot;lower\&quot;,\&quot;authority\&quot;:\&quot;MuJoCo\&quot;,\&quot;role\&quot;:\&quot;body\&quot;},{\&quot;id\&quot;:\&quot;world.obstacle\&quot;,\&quot;def\&quot;:\&quot;ObstacleHandle\&quot;,\&quot;mj\&quot;:\&quot;obstacle\&quot;,\&quot;authority\&quot;:\&quot;X3D authoring → compile\&quot;,\&quot;role\&quot;:\&quot;static geom\&quot;},{\&quot;id\&quot;:\&quot;arm.goal\&quot;,\&quot;def\&quot;:\&quot;TargetHandle\&quot;,\&quot;mj\&quot;:\&quot;shoulder/elbow targets\&quot;,\&quot;authority\&quot;:\&quot;X3D command → controller\&quot;,\&quot;role\&quot;:\&quot;controller target\&quot;},{\&quot;id\&quot;:\&quot;sensor.tip_touch\&quot;,\&quot;def\&quot;:\&quot;ContactForce\&quot;,\&quot;mj\&quot;:\&quot;tip_touch\&quot;,\&quot;authority\&quot;:\&quot;MuJoCo\&quot;,\&quot;role\&quot;:\&quot;physical sensor\&quot;}],\&quot;losses\&quot;:[\&quot;Experimental contact-arm/1 subset, not a general X3D↔MJCF converter.\&quot;,\&quot;X3D cylinders/spheres illustrate MuJoCo capsule links; link collision is disabled, with contact at the spherical tip only.\&quot;,\&quot;No native X3D RigidBodyPhysics conformance is claimed: MuJoCo is the external dynamics authority.\&quot;,\&quot;Imported X3D is normalized to this profile. Only declared physical annotations, obstacle position/radius and joint targets are read; other presentation edits are reported as outside the importer contract.\&quot;,\&quot;Snapshots and experiment records are not full integration-state replay checkpoints.\&quot;]}&quot;"/>
  <MetadataDouble DEF="UpperLength" containerField="value" name="upperLength_m" value="0.55"/>
  <MetadataDouble DEF="LowerLength" containerField="value" name="lowerLength_m" value="0.45"/>
  <MetadataDouble DEF="UpperMass" containerField="value" name="upperMass_kg" value="0.65"/>
  <MetadataDouble DEF="LowerMass" containerField="value" name="lowerMass_kg" value="0.4"/>
  <MetadataDouble DEF="JointTargets" containerField="value" name="jointTargets_rad" value="0.35 0.6"/>
  <MetadataDouble DEF="ContactForce" containerField="value" name="tip_touch_N" value="3.5207360047863183"/>
  <MetadataDouble DEF="SimTime" containerField="value" name="simulation_time_s" value="4.999999999999671"/>
 </MetadataSet>
 </WorldInfo>
 <NavigationInfo type='"EXAMINE" "ANY"' headlight="true"/>
 <Background skyColor=".025 .045 .075"/>
 <Viewpoint DEF="HomeView" description="Workshop" position=".5 1.9 1.7" orientation="1 0 0 -.65" centerOfRotation=".4 .34 -.3"/>
 <Viewpoint DEF="TopView" description="Plan / joint targets" position=".5 2.8 -.3" orientation="1 0 0 -1.57079632679" centerOfRotation=".4 .34 -.3"/>
 <DirectionalLight direction="-.4 -1 -.3" intensity="1"/>
 <Transform translation=".4 -.015 -.25"><Shape><Appearance><Material diffuseColor=".09 .15 .2"/></Appearance><Box size="3 .02 3"/></Shape></Transform>
 <Transform translation="0 .16 0"><Shape><Appearance><Material diffuseColor=".28 .34 .42" specularColor=".4 .4 .4"/></Appearance><Cylinder radius=".13" height=".32"/></Shape></Transform>
 <Transform DEF="BodyUpper" translation="0 0.34 0" rotation="0 1 0 0.16553859361855724">
  <MetadataString containerField="metadata" name="bridge.logicalId" value='"arm.upper"'/><TouchSensor DEF="UpperPick" description="Inspect upper link"/>
  <Transform translation="0.275 0 0" rotation="0 0 1 -1.57079632679"><Shape><Appearance><Material DEF="UpperMaterial" diffuseColor=".15 .64 .87" specularColor=".5 .5 .5" shininess=".5"/></Appearance><Cylinder radius=".045" height="0.55"/></Shape></Transform>
  <Shape><Appearance><Material diffuseColor=".67 .85 .94"/></Appearance><Cylinder radius=".08" height=".11"/></Shape>
 </Transform>
 <Transform DEF="BodyLower" translation="0.5424813608619259 0.34 -0.09063097217504082" rotation="0 1 0 0.7279176282193887">
  <MetadataString containerField="metadata" name="bridge.logicalId" value='"arm.lower"'/><TouchSensor DEF="LowerPick" description="Inspect lower link"/>
  <Transform translation="0.225 0 0" rotation="0 0 1 -1.57079632679"><Shape><Appearance><Material DEF="LowerMaterial" diffuseColor=".56 .82 .31" specularColor=".4 .4 .4" shininess=".4"/></Appearance><Cylinder radius=".035" height="0.45"/></Shape></Transform>
  <Shape><Appearance><Material diffuseColor=".72 .92 .53"/></Appearance><Cylinder radius=".065" height=".1"/></Shape>
  <Transform translation="0.45 0 0"><Shape><Appearance><Material DEF="TipMaterial" diffuseColor="1 .48 .2" emissiveColor=".05 .08 .02"/></Appearance><Sphere radius=".06"/></Shape></Transform>
 </Transform>
 <Transform translation="0 .34 0" rotation="1 0 0 -1.57079632679">
  <PlaneSensor DEF="ObstacleDrag" description="Author obstacle position; commits to physics on release" offset="0.88 0.56 0" minPosition=".2 .15" maxPosition="1.1 .95"/>
  <Transform DEF="ObstacleHandle" translation="0.88 0.56 0"><MetadataString containerField="metadata" name="bridge.logicalId" value='"world.obstacle"'/><Shape><Appearance><Material diffuseColor=".97 .46 .19" specularColor=".5 .4 .2" shininess=".6"/></Appearance><Sphere DEF="ObstacleGeometry" radius="0.11"/></Shape></Transform>
 </Transform>
 <Transform translation="0 .34 0" rotation="1 0 0 -1.57079632679">
  <PlaneSensor DEF="TargetDrag" description="Command a reachable goal; elbow-positive IK branch" offset="0.7784123823248061 0.5546307712557165 0" minPosition="-.9 -.9" maxPosition="1.4 1.4"/>
  <Transform DEF="TargetHandle" translation="0.7784123823248061 0.5546307712557165 0"><MetadataString containerField="metadata" name="bridge.logicalId" value='"arm.goal"'/><Shape><Appearance><Material diffuseColor=".2 .9 1" emissiveColor=".05 .4 .5" transparency=".25"/></Appearance><Sphere radius=".034"/></Shape></Transform>
 </Transform>
 <Switch DEF="ContactSwitch" whichChoice="0"><Transform DEF="ContactMarker" translation="0.878986694435874 0.34 -0.45001275052326406"><Shape><Appearance><Material diffuseColor="1 .2 .3" emissiveColor=".5 .02 .05"/></Appearance><Sphere radius=".022"/></Shape></Transform></Switch>
 <ROUTE fromNode="ObstacleDrag" fromField="translation_changed" toNode="ObstacleHandle" toField="set_translation"/>
 <ROUTE fromNode="TargetDrag" fromField="translation_changed" toNode="TargetHandle" toField="set_translation"/>
</Scene></X3D>