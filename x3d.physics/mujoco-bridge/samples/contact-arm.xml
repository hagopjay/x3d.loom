<mujoco model="contact_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default><joint damping="0.12" armature="0.02" limited="true" range="-2.4 2.4"/><geom friction="0.8 0.01 0.001" solref="0.015 1"/></default>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.13 0.19 0.24 1"/>
    <geom name="pedestal" type="cylinder" pos="0 0 0.16" size="0.13 0.16" rgba="0.25 0.3 0.36 1"/>
    <geom name="obstacle" type="sphere" pos="0.88 0.56 0.34" size="0.11" rgba="0.97 0.53 0.27 1"/>
    <body name="upper" pos="0 0 0.34">
      <joint name="shoulder" type="hinge" axis="0 0 1"/>
      <geom name="upper_link" type="capsule" fromto="0 0 0 0.55 0 0" size="0.045" mass="0.65" rgba="0.22 0.68 0.9 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.08 0.055" mass="0" rgba="0.65 0.85 0.94 1" contype="0" conaffinity="0"/>
      <body name="lower" pos="0.55 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1"/>
        <geom name="lower_link" type="capsule" fromto="0 0 0 0.45 0 0" size="0.035" mass="0.4" rgba="0.6 0.85 0.36 1" contype="0" conaffinity="0"/>
        <geom type="cylinder" size="0.065 0.05" mass="0" rgba="0.75 0.94 0.57 1" contype="0" conaffinity="0"/>
        <geom name="tip" type="sphere" pos="0.45 0 0" size="0.06" mass="0.07" rgba="0.9 0.98 0.76 1"/>
        <site name="tip_site" pos="0.45 0 0" size="0.065"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder_motor" joint="shoulder" ctrllimited="true" ctrlrange="-8 8"/>
    <motor name="elbow_motor" joint="elbow" ctrllimited="true" ctrlrange="-5 5"/>
  </actuator>
  <sensor>
    <jointpos name="shoulder_angle" joint="shoulder"/><jointpos name="elbow_angle" joint="elbow"/>
    <framepos name="tip_position" objtype="site" objname="tip_site"/>
    <touch name="tip_touch" site="tip_site"/>
  </sensor>
  <keyframe><key name="home" qpos="-0.45 1.45"/><key name="press" qpos="0.35 0.6"/></keyframe>
</mujoco>