{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "loom.evidence-manifest/2",
 "title": "Loom evidence manifest",
 "description": "v2 (third external review; `stale` added in the fourth: an optional record for another candidate or with drifted evidence, 18 Nov 2026): failed visible witnesses get their own `failed` list instead of being written into `not_run`; the profile's exact bytes are named by `profile_sha256`; the manifest is published together with its receipt. Lists every evidence file of one accepted run with its hash, so a reader can check the release after extraction (Loomsong v4 check_release.py; LS1 section 8). Evidence is excluded from the candidate and hashed here instead, which avoids a self-referential digest.",
 "type": "object",
 "required": [
  "schema",
  "subject",
  "candidate_sha256",
  "profile",
  "receipt",
  "files",
  "not_run",
  "failed",
  "profile_sha256"
 ],
 "properties": {
  "schema": {
   "const": "loom.evidence-manifest/2"
  },
  "subject": {
   "type": "string"
  },
  "candidate_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "profile": {
   "type": "string"
  },
  "receipt": {
   "type": "object",
   "required": [
    "path",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "files": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "path",
     "sha256",
     "bytes",
     "role"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "bytes": {
      "type": "integer",
      "minimum": 0
     },
     "role": {
      "enum": [
       "witness-record",
       "log",
       "frame",
       "trace",
       "audio",
       "report",
       "picture-review",
       "other"
      ]
     },
     "synthetic": {
      "type": "boolean",
      "description": "True for fixtures, seeded mutants and teaching data"
     }
    }
   }
  },
  "not_run": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "witness",
     "status",
     "reason"
    ],
    "properties": {
     "witness": {
      "type": "string"
     },
     "status": {
      "enum": [
       "not_run",
       "deferred",
       "not_applicable",
       "error",
       "stale"
      ]
     },
     "reason": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "profile_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "failed": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "witness",
     "status",
     "reason"
    ],
    "properties": {
     "witness": {
      "type": "string"
     },
     "status": {
      "enum": [
       "fail"
      ]
     },
     "reason": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
