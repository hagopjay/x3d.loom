   "sha256": "c61bd119c33b5f1d1e197fc020cc4b15fd38de1ad088d34976d990bf14824751",
   "grade": "L",
   "statement": "Extend the diagonal of the first pyramid to the south-west and it runs through the heart of the second.",
   "source": "Petrie 1883 s.92"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:eight_sides",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Suspected",
