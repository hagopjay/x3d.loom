   },
   "sha256": "b1b68b3e34fde967b168ddaacd0bc1773aeef27cb8a4b691b3ade80db56b21a6",
   "grade": "S",
   "statement": "At dawn on the equinox a shadow line splits each face in two: the faces are dished, and the pyramid has eight sides, not four.",
   "source": "Petrie 1883 (hollowing of the core faces), not re-read here"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_latitude",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "refuted",
   "gradeNative": {
    "grade": "False",
    "design": "Coincidence"
   },
   "sha256": "3c3bcb81a1755507e84de59a7a6d89111792419f066a325d4ad3e107426af124",
   "statement": "The latitude of the Great Pyramid is 29.9792458° N. The speed of light is 299,792,458 m/s.",
   "source": "v1 receipt (verify_numbers.py): aera_gpmp, wgs84, si"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:scale_43200_perimeter",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Coincidence"
   },
   "sha256": "c58a0d6d0df877f085375cfdb2687f4a752fa47a9139a67fd76f53ff3c29507c",
   "grade": "L",
   "statement": "43,200 is half the seconds in a day. Multiply the perimeter by it and you get the Earth's equator.",
   "source": "Dash 2015 base; WGS84 equator"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:scale_43200_height",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Coincidence"
   },
   "sha256": "6d78abd3b51c58c37af18d91fb722c5f7b3e50d2948dab041af14bd1ca155a59",
   "grade": "L",
   "statement": "Multiply the height by the same 43,200 and you get the distance from the Earth's centre to the pole.",
   "source": "Petrie slope 51°52′; WGS84 polar radius"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:circles_light",
   "@type": "Claim",
   "dialect": "giza-atlas",
