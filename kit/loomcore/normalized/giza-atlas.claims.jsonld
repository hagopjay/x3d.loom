   },
   "sha256": "c7d24040b245389a7421c5d2acf5f4e7253e7bbb709ba9d34889dc4998156c4e",
   "grade": "L",
   "statement": "A ruler laid on the south-east corners of all three pyramids touches each one, and points to Heliopolis.",
   "source": "Petrie 1883 s.92 (centres), s.21, s.66, s.80 (bases)"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:khufu_diagonal",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
