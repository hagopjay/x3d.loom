   },
   "sha256": "0d7c7345441f0ce30a66b9eaeb14bd259ded717bf457410cb5a543ecced18db5",
   "grade": "C",
   "statement": "The casing joints are thinner than a fingernail.",
   "source": "v1 receipt (verify_numbers.py): petrie"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_north",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "3b3418cf297e0f2d0be06253ddb80b9e00f8db486f1b7939458c491236f0ed0b",
   "grade": "C",
   "statement": "It faces true north more exactly than the Greenwich observatory was built.",
   "source": "v1 receipt (verify_numbers.py): cole, petrie"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:square_sides",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "21aeafdbf5bc08992a8681a739002f34cdd687a80f13c8ff6deeaaa192ffeb76",
   "grade": "C",
   "statement": "Four sides of 230 metres that differ by less than the width of your hand.",
   "source": "Petrie 1883 s.21"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:giza_diagonal",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
