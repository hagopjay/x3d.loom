 "@graph": [
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_base",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "1c721bf6288679da790d6c31c38600323941eed0ddc015d92cdb20d091913b95",
   "grade": "C",
   "statement": "Each side of the Great Pyramid is 756 feet long.",
   "source": "v1 receipt (verify_numbers.py): dash, petrie, lehner"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_height",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Suspected",
    "design": "Coincidence"
   },
   "sha256": "07f148efb0a750ac6c93bcff6cdd060f9c1cca1dd3da638ae0977edd2fe2b09a",
   "grade": "S",
   "statement": "Without its capstone it stood 480 feet: one eleventh of a mile.",
   "source": "v1 receipt (verify_numbers.py): petrie, dash, lehner"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_ratio711",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "e8e62ffbea2b245a65f62a8023f52a4b728d199df61b37ae03adbc41998502c6",
   "grade": "C",
   "statement": "Height to base is 7 to 11, a ratio you can count on your fingers.",
   "source": "v1 receipt (verify_numbers.py): petrie, lehner"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_acres",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Coincidence"
   },
   "sha256": "20166db9f32f7705b59cca5dfe69df651706d0fb42e4bb29a4a7dfe8ad15db49",
   "grade": "C",
   "statement": "The base covers thirteen acres.",
   "source": "v1 receipt (verify_numbers.py): dash"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_blocks",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Unknown"
   },
   "sha256": "54828bf98dde2d89c697709cd6c1208ee2acaad564c5594bd5b49ad590df5314",
   "grade": "L",
   "statement": "Two million three hundred thousand blocks.",
   "source": "v1 receipt (verify_numbers.py): lehner"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_pi",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Possible"
   },
   "sha256": "78c24a90bf4978b11f5526bb4e2f0fe4579d00359586f9888e1fcd0be5c0d876",
   "grade": "C",
   "statement": "Walk around the base, divide by twice the height: π.",
   "source": "v1 receipt (verify_numbers.py): petrie, dash, lehner"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_tau",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Possible"
   },
   "sha256": "2f9f2076456cff472a151476fabce7332c3382d9d6012bb93226749b1803a659",
   "grade": "C",
   "statement": "The perimeter divided by the height is 2π: the pyramid is a squared circle.",
   "source": "v1 receipt (verify_numbers.py): petrie, dash"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_phi",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Possible"
   },
   "sha256": "41a50721cc578ff06b847fa1961155753debdef247001c5a2895fd99230faeb4",
   "grade": "L",
   "statement": "The sloping face divided by half the base is the golden ratio.",
   "source": "v1 receipt (verify_numbers.py): petrie, dash"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:khafre_345",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "cc7daf57fdc22e03c993c39ba57d9a75bd9ad1f08e261429294ad76a68c8dfa9",
   "grade": "C",
   "statement": "Half the base, the height and the sloping face of the second pyramid stand as 3 : 4 : 5, the first Pythagorean triple.",
   "source": "Petrie 1883 s.66 (base mean 8474.9 in), s.67 (53°10′ ± 4′; height 5,664 ± 13 in)"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:menkaure_slope",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Possible"
   },
   "sha256": "73671b3af05ebc2a2888ff2a1b9bc90e27f63c9dc804ae665262cc082a2e0e19",
   "grade": "L",
   "statement": "The third pyramid rises at the same 51° and a fraction as the first: the π slope, a third of the size.",
   "source": "Petrie 1883 s.80 (base mean 4153.6 in), s.81 (51°0′ ± 10′; height 2564 ± 15 in)"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:seked",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "2dae76636f47538a14ecb98bf0b4f02287e23da4fc507707a89eeaf8d48ed260",
   "grade": "C",
   "statement": "Rise one cubit, run five and a half palms. One rule, repeated for every casing stone, makes the whole shape.",
   "source": "Petrie 1883 s.25 (51°52′ ± 2′); Rhind Mathematical Papyrus problems 56-60 for the seked"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:pi_phi_identity",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Coincidence"
   },
   "sha256": "5e3ca04288d85f7edef64f6483e614212c5390a16674686aac99b5e3be242208",
   "grade": "C",
   "statement": "The same triangle gives the circle's number and the golden number. Two of the deepest constants in one pile of stone.",
   "source": "Arithmetic; Petrie 1883 s.25"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:herodotus_face",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Possible"
   },
   "sha256": "000d02e8b1a4af9fd39b5cb6cc217036f520949714d9a8aebf42880533cd59c6",
   "grade": "L",
   "statement": "Said to come from Herodotus: the square on the height equals a face.",
   "source": "Dash 2015 base, Petrie slope; attribution not re-read: Suspected"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:khafre_137",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Coincidence"
   },
   "sha256": "c226cc3115129be937a608be5babfa8b435d21c3849ba75f43c72f6607a6d2cb",
   "grade": "C",
   "statement": "Its base is 411 cubits: three times 137. Its height is 274: twice 137. And 137 is the fine-structure number that governs light and matter.",
   "source": "Petrie 1883 s.66, s.136; CODATA 1/α. An invented claim, made here to show how easy they are"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:cubit_pi6",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Coincidence"
   },
   "sha256": "6691ad40c02468757d8a80e8195dda6a4df0c501d74d78e204370bd2f0a7df41",
   "grade": "C",
   "statement": "Divide π by six and you get 0.5236. That is the royal cubit in metres, a unit defined in France in 1791.",
   "source": "Petrie 1883 s.136 (20.620 ± .005), s.52 (20.632 ± .004 in the King's Chamber)"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:cubits_440_280",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "c3939dec5c40abf20f93c60359aa6d15a531250ffd15849b2ecd243fb5979e78",
   "grade": "C",
   "statement": "In the builders' own unit the pyramid is two round numbers.",
   "source": "Petrie 1883 s.21, s.25, s.136, s.143, s.157"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:perimeter_1760",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Coincidence"
   },
   "sha256": "f257cc525ea0af7971e48bc91953466c6aaa1604f047c69aa47ec5bf8cae510c",
   "grade": "C",
   "statement": "Walk around the pyramid: 1,760 cubits. Walk a mile: 1,760 yards.",
   "source": "Arithmetic; statute mile of 1593"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:pyramid_inch_year",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "refuted",
   "gradeNative": {
    "grade": "False",
    "design": "Coincidence"
   },
   "sha256": "a078c665f28159d276926ea4567f1694831d9491bf8ebb0316fe6d613c739b30",
   "statement": "Piazzi Smyth, Astronomer Royal for Scotland, 1864: the side of the base counts the days of the year.",
   "source": "Petrie 1883 s.21, s.143, s.150"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:perimeter_36524",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "refuted",
   "gradeNative": {
    "grade": "False",
    "design": "Coincidence"
   },
   "sha256": "29bc69e96c9df94fef9f5e93eebcfcc839e799e725942bd7bd369c71902a913c",
   "statement": "A calendar in stone.",
   "source": "Petrie 1883 s.21"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:kings_chamber",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Possible"
   },
   "sha256": "34f2664f08ffceef776473bdc14167f27ccf0016faed60f71d0fe5a9357c1ba0",
   "grade": "C",
   "statement": "The room is 10 by 20 cubits. Its height is 5√5 cubits, so the end-wall diagonal is 15, the floor is 20 long, and the diagonal through the room is 25: a 3-4-5 triangle scaled by five.",
   "source": "Petrie 1883 s.155 (206.12, 412.24, 230.09 ± .15 in; floor raised 5.11 ± .12 in above the wall base), s.55 and s.64 (levels)"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:kc_half_area",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Possible"
   },
   "sha256": "48fcfa61fa80c4ff19bc3ed24734ac3733222d7816d07a1f40cead943aadaa88",
   "grade": "C",
   "statement": "Cut the pyramid level with the chamber floor: the slice is exactly half the area of the base.",
   "source": "Petrie 1883 s.25 (height), s.55 and s.64 (floor level)"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:qc_half_level",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Possible"
   },
   "sha256": "9b6fda19def42f7c3bc238c0f2d70b5acb4f3d1cdd1dbad7de1ba9e64a1bbb68",
   "grade": "L",
   "statement": "One chamber exactly halfway up to the other.",
   "source": "Petrie 1883 s.40, s.41, s.64"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:qc_midplane",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "73a462591648e4f87855fff7579ce9650d6a8c224a662f4352ef892d03220d95",
   "grade": "C",
   "statement": "The roof ridge of the Queen's Chamber lies in the east-west plane through the apex.",
   "source": "Petrie 1883 s.41, s.55, s.64"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:passage_1_in_2",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
    "design": "Designed"
   },
   "sha256": "4d1c2e341d06bf7173dd703005fc869b8d789b0f243ae9f8b62cf5d296c7df22",
   "grade": "C",
   "statement": "Down into the rock for a hundred metres, one unit down for every two along.",
   "source": "Petrie 1883 s.36, s.38, s.45, s.151"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:coffer_double",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Possible"
   },
   "sha256": "2fcc99c7af2a70537b7668bdecfb3a5296952877b075ce7571a2f004df2e0751",
   "grade": "L",
   "statement": "The granite box in the King's Chamber: its outer volume is exactly double what it holds.",
   "source": "Petrie 1883 s.59, s.61"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_level",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Likely",
    "design": "Designed"
   },
   "sha256": "8b17e8660c337f2c114895620a9bd492f4fd24c5b2e31ecd50ac4ff449531d27",
   "grade": "L",
   "statement": "The whole base is level to the width of a thumb.",
   "source": "v1 receipt (verify_numbers.py): lehner, petrie"
  },
  {
   "@id": "urn:x3d:giza-atlas:v4:claim:v1_joints",
   "@type": "Claim",
   "dialect": "giza-atlas",
   "verdict": "supported",
   "gradeNative": {
    "grade": "Confirmed",
