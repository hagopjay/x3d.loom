{
  "@context": {
    "@version": 1.1,
    "loom": "urn:loom:core:",
    "prov": "http://www.w3.org/ns/prov#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Claim": "loom:Claim",
    "Evidence": "loom:Evidence",
    "Receipt": "loom:Receipt",
    "grade": { "@id": "loom:grade", "@type": "@vocab" },
    "gradeNative": "loom:gradeNative",
    "verdict": { "@id": "loom:verdict", "@type": "@vocab" },
    "statement": "loom:statement",
    "about": { "@id": "loom:about", "@type": "@id" },
    "source": "dct:source",
    "instrument": "loom:instrument",
    "derivedFrom": { "@id": "prov:wasDerivedFrom", "@type": "@id" },
    "part": { "@id": "loom:part", "@type": "@id" },
    "locator": "loom:locator",
    "dialect": "loom:dialect",
    "sha256": "loom:sha256",
    "normalizedFrom": "loom:normalizedFrom",
    "C": "loom:grade:C",
    "L": "loom:grade:L",
    "S": "loom:grade:S",
    "supported": "loom:verdict:supported",
    "refuted": "loom:verdict:refuted",
    "untested": "loom:verdict:untested"
  }
}
