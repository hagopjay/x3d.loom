<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content="A bracket that is kept in a file of its own is shown standing next to a grey marker post."/>
  </head>
  <Scene>
    <Viewpoint description='Bench' position='0 1 7'/>
    <Transform translation='-2 0 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.5 0.5 0.5'/>
        </Appearance>
        <Cylinder height='2' radius='0.15'/>
      </Shape>
    </Transform>
    <Transform translation='1 0 0'>
      <Inline url='"helper-bracket.x3d"'/>
    </Transform>
  </Scene>
</X3D>
