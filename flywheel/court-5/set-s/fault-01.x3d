<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content="A closed wedge-shaped door stop is looked at from outside and every one of its five faces is seen."/>
  </head>
  <Scene>
    <Viewpoint description='Wedge' position='0 2 6' orientation='1 0 0 -0.25'/>
    <Transform rotation='0 1 0 2.6'>
    <Shape>
      <Appearance>
        <Material diffuseColor='0.1 0.3 0.8'/>
      </Appearance>
      <IndexedFaceSet coordIndex='
          0 3 2 1 -1
          0 1 4 -1
          3 2 5 -1
          1 2 5 4 -1
          0 3 5 4 -1'>
        <Coordinate point='
            0 0 1
            2 0 1
            2 0 -1
            0 0 -1
            0 1 1
            0 1 -1'/>
      </IndexedFaceSet>
    </Shape>
    </Transform>
  </Scene>
</X3D>
