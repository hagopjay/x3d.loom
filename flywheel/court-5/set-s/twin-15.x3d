<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Full' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content="Five survey marks are drawn as large dots, several pixels across, so they can be seen from the start view."/>
  </head>
  <Scene>
    <Viewpoint description='Marks' position='0 0 10'/>
    <Shape>
      <Appearance>
        <Material emissiveColor='1 0.9 0.2'/>
        <PointProperties pointSizeScaleFactor='12' pointSizeMinValue='5' pointSizeMaxValue='100'/>
      </Appearance>
      <PointSet>
        <Coordinate point='-2 -1 0  -1 1 0  0 0 0  1 1 0  2 -1 0'/>
      </PointSet>
    </Shape>
  </Scene>
</X3D>
