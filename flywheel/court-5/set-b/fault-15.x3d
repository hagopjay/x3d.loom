<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 15'/>
    <meta name="intent:prose" content="A machined bracket carries two facts as metadata for the parts list: the alloy it is made of and its mass in kilograms."/>
  </head>
  <Scene>
    <Viewpoint description='Part' position='0 0 5'/>
    <Shape DEF='BracketShape'>
      <MetadataString containerField='metadata' name='alloy' value='"6061-T6"'/>
      <MetadataFloat containerField='metadata' name='massKg' value='0.42'/>
      <Appearance><Material diffuseColor='0.7 0.7 0.75'/></Appearance>
      <Box size='2 1 0.3'/>
    </Shape>
  </Scene>
</X3D>
