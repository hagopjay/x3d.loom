<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 07'/>
    <meta name="intent:prose" content="A flat blue arrow-head (a chevron with a notch cut into its back edge) is drawn as one polygon facing the viewer."/>
  </head>
  <Scene>
    <Viewpoint description='Front' position='0 0 8'/>
    <Shape>
      <Appearance><Material diffuseColor='0 0 0' emissiveColor='0.2 0.4 1'/></Appearance>
      <IndexedFaceSet solid='false' coordIndex='0 1 2 3 -1'>
        <Coordinate point='-2 2 0, 0 0 0, -2 -2 0, 2.5 0 0'/>
      </IndexedFaceSet>
    </Shape>
  </Scene>
</X3D>
