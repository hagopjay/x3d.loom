<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <unit category='angle' name='degree' conversionFactor='0.017453292519943295'/>
    <meta name='title' content='Hatch in degrees'/>
    <meta name="intent:prose" content="A hatch cover stands open a quarter turn about its hinge; the author works in degrees and says so in the head."/>
    <meta name="intent" content="after 0.5s: Hatch.rotation[3] &lt; -1.5"/>
    <meta name="intent" content="after 0.5s: Hatch.rotation[3] &gt; -1.6"/>
  </head>
  <Scene>
    <Viewpoint description='Hatch' position='3 2 6' orientation='-0.5 0.85 0.15 0.55'/>
    <Shape>
      <Appearance><Material diffuseColor='0.4 0.4 0.4'/></Appearance>
      <Box size='2 0.2 2'/>
    </Shape>
    <Transform DEF='Hatch' translation='0 0.1 -1' rotation='1 0 0 -90'>
      <Transform translation='0 0.05 1'>
        <Shape>
          <Appearance><Material diffuseColor='0.8 0.6 0.1'/></Appearance>
          <Box size='1.6 0.1 1.6'/>
        </Shape>
      </Transform>
    </Transform>
  </Scene>
</X3D>
