<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 13'/>
    <meta name="intent:prose" content="A steel bracket kept in its own file next to this one is brought into the assembly beside a blue base plate."/>
  </head>
  <Scene>
    <Viewpoint description='Assembly' position='0 0.5 6'/>
    <Transform translation='0 -0.6 0'>
      <Shape>
        <Appearance><Material diffuseColor='0.2 0.3 0.8'/></Appearance>
        <Box size='4 0.2 2'/>
      </Shape>
    </Transform>
    <Inline DEF='Bracket' url='"helper-bracket.x3d"'/>
  </Scene>
</X3D>
