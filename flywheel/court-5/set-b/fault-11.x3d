<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 11'/>
    <meta name="intent:prose" content="The lid of a chest stands open, tipped a quarter turn back about its rear hinge edge."/>
  </head>
  <Scene>
    <Viewpoint description='Chest' position='3 2 6' orientation='-0.5 0.85 0.15 0.55'/>
    <Shape>
      <Appearance><Material diffuseColor='0.5 0.3 0.1'/></Appearance>
      <Box size='2 1 1'/>
    </Shape>
    <Transform DEF='Lid' translation='0 0.5 -0.5' rotation='0 0 0 -1.5708'>
      <Transform translation='0 0.05 0.5'>
        <Shape>
          <Appearance><Material diffuseColor='0.7 0.5 0.2'/></Appearance>
          <Box size='2 0.1 1'/>
        </Shape>
      </Transform>
    </Transform>
  </Scene>
</X3D>
