<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 10'/>
    <meta name="intent:prose" content="A sign shows the words Exit this way in white letters, centred left-to-right on the doorway axis in front of the visitor."/>
    <meta name="intent" content="after 1.5s: Sign.origin[0] &lt; -1"/>
  </head>
  <Scene>
    <Viewpoint description='Sign' position='0 0 8'/>
    <Shape>
      <Appearance><Material diffuseColor='0 0 0' emissiveColor='1 1 1'/></Appearance>
      <Text DEF='Sign' string='"Exit this way"'>
        <FontStyle justify='"MIDDLE"' size='1'/>
      </Text>
    </Shape>
  </Scene>
</X3D>
