<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 17'/>
    <meta name="intent:prose" content="A flat blue floor mat, three metres by two, lies on the ground and is seen from a camera looking straight down on it."/>
  </head>
  <Scene>
    <Viewpoint description='From above' position='0 8 0' orientation='1 0 0 -1.5708'/>
    <Transform DEF='Mat' translation='0 0.01 0'>
        <Shape>
          <Appearance><Material diffuseColor='0 0 0' emissiveColor='0.2 0.4 0.9'/></Appearance>
          <Rectangle2D size='3 2' solid='false'/>
        </Shape>
    </Transform>
  </Scene>
</X3D>
