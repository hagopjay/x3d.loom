<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 14'/>
    <meta name="intent:prose" content="A square tile carries a two-by-two checker of red, green, blue and white texels drawn without smoothing."/>
  </head>
  <Scene>
    <Viewpoint description='Tile' position='0 0 5'/>
    <Shape>
      <Appearance>
        <Material diffuseColor='1 1 1'/>
        <PixelTexture image='2 2 3 0xFF0000 0x00FF00 0x0000FF'>
          <TextureProperties magnificationFilter='NEAREST_PIXEL' minificationFilter='NEAREST_PIXEL'/>
        </PixelTexture>
      </Appearance>
      <IndexedFaceSet coordIndex='0 1 2 3 -1' texCoordIndex='0 1 2 3 -1'>
        <Coordinate point='-1.5 -1.5 0, 1.5 -1.5 0, 1.5 1.5 0, -1.5 1.5 0'/>
        <TextureCoordinate point='0 0, 1 0, 1 1, 0 1'/>
      </IndexedFaceSet>
    </Shape>
  </Scene>
</X3D>
