<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 01'/>
    <meta name="intent:prose" content="A bench imported from a model drawn in centimetres is scaled into metres, and a red beacon ball of 15 cm radius floats two metres above the floor, over the bench."/>
  </head>
  <Scene>
    <Viewpoint DEF='View' description='Bench' position='0 1 6'/>
    <!-- the bench was drawn in centimetres -->
    <Transform DEF='ImportedBench' scale='0.01 0.01 0.01'>
      <Transform translation='0 25 0'>
        <Shape>
          <Appearance><Material diffuseColor='0.6 0.4 0.2'/></Appearance>
          <Box size='200 50 60'/>
        </Shape>
      </Transform>
    </Transform>
    <Transform DEF='Beacon' translation='0 2 0'>
      <Shape>
        <Appearance><Material diffuseColor='1 0 0'/></Appearance>
        <Sphere radius='0.15'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
