<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 12'/>
    <meta name="intent:prose" content="A table top two metres long, ninety centimetres deep and four centimetres thick is seen from a viewpoint five metres away."/>
  </head>
  <Scene>
    <Viewpoint description='Table' position='0 1.2 5' orientation='1 0 0 -0.1'/>
    <Transform translation='0 0.75 0'>
      <Shape DEF='TableTop'>
        <Appearance><Material diffuseColor='0.6 0.4 0.2'/></Appearance>
        <Box size='2000 40 900'/>
      </Shape>
    </Transform>
    <Transform translation='0 0.365 0'>
      <Shape>
        <Appearance><Material diffuseColor='0.3 0.3 0.3'/></Appearance>
        <Cylinder height='0.73' radius='0.06'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
