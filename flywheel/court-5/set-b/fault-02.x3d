<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 02'/>
    <meta name="intent:prose" content="A grey partition wall stands in the gallery; visitors see it and cannot walk through it."/>
  </head>
  <Scene>
    <Viewpoint description='Gallery' position='0 1.6 8'/>
    <Collision DEF='Partition'>
      <Shape containerField='proxy'>
        <Appearance><Material diffuseColor='0.7 0.7 0.7'/></Appearance>
        <Box size='6 3 0.2'/>
      </Shape>
    </Collision>
    <Transform translation='0 -1.55 0'>
      <Shape>
        <Appearance><Material diffuseColor='0.3 0.5 0.3'/></Appearance>
        <Box size='12 0.1 12'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
