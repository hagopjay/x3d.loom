<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Geospatial' level='1'/>
    <meta name='title' content='Set b scene 20'/>
    <meta name="intent:prose" content="A sixty-metre red marker block sits on the ground at latitude 48.8584 north, longitude 2.2945 east, and the camera hovers four hundred metres straight above it looking down."/>
  </head>
  <Scene>
    <GeoViewpoint description='Above the marker' geoSystem='"GD" "WE"' position='48.8584 2.2945 400' orientation='1 0 0 -1.5708'/>
    <GeoLocation DEF='Marker' geoSystem='"GD" "WE"' geoCoords='2.2945 48.8584 0'>
      <Shape>
        <Appearance><Material diffuseColor='0 0 0' emissiveColor='1 0 0'/></Appearance>
        <Box size='60 60 60'/>
      </Shape>
    </GeoLocation>
  </Scene>
</X3D>
