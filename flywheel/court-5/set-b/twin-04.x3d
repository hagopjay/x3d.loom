<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='Set b scene 04'/>
    <meta name="intent:prose" content="A statue stands a hundred metres east of the origin; from the entry viewpoint eight metres in front of it the visitor sees the detailed version, and the plain block only from far away."/>
    <meta name="intent" content="after 1.0s: StatueLOD.level_changed == 0"/>
  </head>
  <Scene>
    <Viewpoint description='Entry' position='100 1 8'/>
    <LOD DEF='StatueLOD' range='25' center='100 0 0'>
      <Transform translation='100 0 0'>
        <Shape>
          <Appearance><Material diffuseColor='0.8 0.7 0.3'/></Appearance>
          <Sphere radius='0.6'/>
        </Shape>
        <Transform translation='0 1.4 0'>
          <Shape>
            <Appearance><Material diffuseColor='0.8 0.7 0.3'/></Appearance>
            <Cone bottomRadius='0.5' height='1.6'/>
          </Shape>
        </Transform>
      </Transform>
      <Transform translation='100 0.5 0'>
        <Shape>
          <Appearance><Material diffuseColor='0.5 0.5 0.5'/></Appearance>
          <Box size='1.2 3 1.2'/>
        </Shape>
      </Transform>
    </LOD>
  </Scene>
</X3D>
