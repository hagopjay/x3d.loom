<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='NURBS' level='1'/>
    <meta name='title' content='Set b scene 18'/>
    <meta name="intent:prose" content="A smooth yellow arch is drawn as a single curve bent by three control points."/>
  </head>
  <Scene>
    <Viewpoint description='Arch' position='0 1 7'/>
    <Shape>
      <Appearance>
        <Material emissiveColor='1 1 0'/>
        <LineProperties linewidthScaleFactor='3'/>
      </Appearance>
      <NurbsCurve DEF='Arch' order='3' tessellation='24'>
        <Coordinate containerField='controlPoint' point='-2 0 0, 0 3 0, 2 0 0'/>
      </NurbsCurve>
    </Shape>
  </Scene>
</X3D>
