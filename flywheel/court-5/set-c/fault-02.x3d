<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Lighting' level='3'/>
    <meta name='intent:prose' content='A lantern on a pole lights the three pillars standing five metres around it; the viewer&apos;s headlight is off.'/>
  </head>
  <Scene>
    <NavigationInfo headlight='false'/>
    <Background skyColor='0.02 0.02 0.05'/>
    <Viewpoint description='Courtyard' position='0 3 14' orientation='1 0 0 -0.12'/>
    <PointLight DEF='Lantern' location='0 3 0' color='1 0.9 0.7' radius='3'/>
    <Transform translation='0 1.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.3 0.3 0.3'/>
        </Appearance>
        <Cylinder radius='0.05' height='3'/>
      </Shape>
    </Transform>
    <Transform translation='-5 1 0'>
      <Shape DEF='Pillar'>
        <Appearance>
          <Material diffuseColor='0.8 0.8 0.75'/>
        </Appearance>
        <Cylinder radius='0.4' height='2'/>
      </Shape>
    </Transform>
    <Transform translation='5 1 0'>
      <Shape USE='Pillar'/>
    </Transform>
    <Transform translation='0 1 -5'>
      <Shape USE='Pillar'/>
    </Transform>
  </Scene>
</X3D>
