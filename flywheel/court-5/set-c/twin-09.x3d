<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content='A blue-tinted glass pane stands in front of a yellow ball, and the ball is seen through the tint.'/>
  </head>
  <Scene>
    <Background skyColor='0.9 0.9 0.9'/>
    <Viewpoint description='Window' position='0 0 7'/>
    <Shape DEF='Ball'>
      <Appearance>
        <Material diffuseColor='1 0.9 0.1'/>
      </Appearance>
      <Sphere radius='1'/>
    </Shape>
    <Transform translation='0 0 2'>
      <Shape DEF='Pane'>
        <Appearance alphaMode='BLEND'>
          <Material diffuseColor='0.1 0.2 0.9' transparency='0.7'/>
        </Appearance>
        <Box size='3.5 3.5 0.05'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
