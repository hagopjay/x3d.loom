<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content='A wall is covered with a brick picture repeated four times across and four times up.'/>
  </head>
  <Scene>
    <Background skyColor='0.3 0.4 0.5'/>
    <Viewpoint description='Wall' position='0 0 6'/>
    <Shape DEF='Wall'>
      <Appearance>
        <ImageTexture DEF='Bricks' url='"helper-bricks.png"' repeatS='false' repeatT='false'/>
        <TextureTransform scale='4 4'/>
      </Appearance>
      <Box size='4 4 0.2'/>
    </Shape>
  </Scene>
</X3D>
