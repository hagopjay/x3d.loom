<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='Lighting' level='3'/>
    <meta name='intent:prose' content='A ball hovers over a floor and the sun throws its shadow on the floor; the viewer&apos;s headlight is off.'/>
  </head>
  <Scene>
    <NavigationInfo headlight='false'/>
    <Background skyColor='0.5 0.6 0.8'/>
    <Viewpoint description='Floor' position='0 4 10' orientation='1 0 0 -0.3'/>
    <DirectionalLight DEF='Sun' direction='-0.5 -1 -0.3' global='true' shadowIntensity='0.8' shadows='true'/>
    <Transform translation='0 1.5 0'>
      <Shape DEF='Ball'>
        <Appearance>
          <Material diffuseColor='0.9 0.2 0.2'/>
        </Appearance>
        <Sphere radius='0.7'/>
      </Shape>
    </Transform>
    <Transform translation='0 -0.05 0'>
      <Shape DEF='Floor'>
        <Appearance>
          <Material diffuseColor='0.85 0.85 0.8'/>
        </Appearance>
        <Box size='10 0.1 10'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
