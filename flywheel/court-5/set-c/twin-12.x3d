<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content='A row of red posts recedes into pale mist, each post fainter than the one before, the farthest almost gone.'/>
  </head>
  <Scene>
    <Background skyColor='0.8 0.8 0.85'/>
    <Viewpoint description='Along the posts' position='-3 1.5 4' orientation='0 1 0 -0.25'/>
    <Fog DEF='Mist' color='0.8 0.8 0.85' fogType='LINEAR' visibilityRange='50'/>
    <Transform translation='0 1 -5'>
      <Shape DEF='Post'>
        <Appearance>
          <Material diffuseColor='0.8 0.1 0.1'/>
        </Appearance>
        <Cylinder radius='0.3' height='2'/>
      </Shape>
    </Transform>
    <Transform translation='0 1 -15'>
      <Shape USE='Post'/>
    </Transform>
    <Transform translation='0 1 -25'>
      <Shape USE='Post'/>
    </Transform>
    <Transform translation='0 1 -35'>
      <Shape USE='Post'/>
    </Transform>
    <Transform translation='0 1 -45'>
      <Shape USE='Post'/>
    </Transform>
  </Scene>
</X3D>
