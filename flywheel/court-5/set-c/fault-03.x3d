<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content='A copper-coloured ball with a physically based surface.'/>
  </head>
  <Scene>
    <Background skyColor='0.2 0.2 0.25'/>
    <Viewpoint description='Ball' position='0 0 5'/>
    <DirectionalLight direction='-0.4 -0.6 -1' global='true'/>
    <Shape DEF='Ball'>
      <Appearance>
        <PhysicalMaterial diffuseColor='0.85 0.45 0.2' metallic='0.1' roughness='0.5'/>
      </Appearance>
      <Sphere radius='1.2'/>
    </Shape>
  </Scene>
</X3D>
