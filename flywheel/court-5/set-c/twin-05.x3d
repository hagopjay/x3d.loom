<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content='A square tile carries a two by two red and white checker pattern.'/>
  </head>
  <Scene>
    <Background skyColor='0.1 0.1 0.3'/>
    <Viewpoint description='Tile' position='0 0 4'/>
    <Shape DEF='Tile'>
      <Appearance>
        <PixelTexture image='2 2 3 0xFF0000 0xFFFFFF 0xFFFFFF 0xFF0000'>
          <TextureProperties magnificationFilter='NEAREST_PIXEL' minificationFilter='NEAREST_PIXEL'/>
        </PixelTexture>
      </Appearance>
      <Box size='2 2 0.1'/>
    </Shape>
  </Scene>
</X3D>
