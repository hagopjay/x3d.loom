<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='intent:prose' content='A station sign shows the words Platform 9 on one line.'/>
    <meta name='intent' content='after 2s: Sign.textBounds[0] &gt; 1'/>
  </head>
  <Scene>
    <Background skyColor='0.1 0.15 0.3'/>
    <Viewpoint description='Sign' position='2 0.3 7'/>
    <Shape>
      <Appearance>
        <Material diffuseColor='1 1 1'/>
      </Appearance>
      <Text DEF='Sign' string='"Platform 9"'>
        <FontStyle family='"SANS"' size='1'/>
      </Text>
    </Shape>
  </Scene>
</X3D>
