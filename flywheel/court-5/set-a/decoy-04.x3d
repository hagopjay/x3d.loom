<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name='EventUtilities' level='1'/>
    <meta name="intent:prose" content="Nothing is shown until the flip-book is started; it then steps through frames one, two, three, two, one, a fifth of its four second run each, ending on frame one."/>
    <meta name="intent" content="send FlipClock.startTime = now at 0.2s"/>
    <meta name="intent" content="after 2.2s: Frames.whichChoice == 2"/>
    <meta name="intent" content="after 3.4s: Frames.whichChoice == 1"/>
  </head>
  <Scene>
    <Viewpoint description='Flip-book' position='0 0 6'/>
    <Switch DEF='Frames' whichChoice='-1'>
      <Shape><Appearance><Material diffuseColor='0.9 0.3 0.3'/></Appearance><Box size='1 1 1'/></Shape>
      <Shape><Appearance><Material diffuseColor='0.3 0.9 0.3'/></Appearance><Cone bottomRadius='0.7' height='1.4'/></Shape>
      <Shape><Appearance><Material diffuseColor='0.3 0.3 0.9'/></Appearance><Sphere radius='0.7'/></Shape>
    </Switch>
    <Transform translation='0 -2 0'>
      <TouchSensor DEF='Play' description='play'/>
      <Shape><Appearance><Material diffuseColor='0.5 0.5 0.5'/></Appearance><Box size='1 0.3 0.3'/></Shape>
    </Transform>
    <TimeSensor DEF='FlipClock' cycleInterval='4'/>
    <IntegerSequencer DEF='Page' key='0 0.2 0.4 0.6 0.8 1' keyValue='0 1 2 1 0 0'/>
    <ROUTE fromNode='Play' fromField='touchTime' toNode='FlipClock' toField='set_startTime'/>
    <ROUTE fromNode='FlipClock' fromField='fraction_changed' toNode='Page' toField='set_fraction'/>
    <ROUTE fromNode='Page' fromField='value_changed' toNode='Frames' toField='set_whichChoice'/>
  </Scene>
</X3D>
