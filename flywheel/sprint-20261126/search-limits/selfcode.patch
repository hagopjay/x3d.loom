+def _flat(v):
+    return list(v) if isinstance(v, (tuple, list)) else [float(v)]
+
+
+def period_between(values, kind):
+    """A repeat length that falls between samples, in seconds, or None: the lag (in samples, fractional) at which the
+    series, read by straight lines between samples, best matches itself, found by a coarse scan and a golden-section refine."""
+    if kind not in ("SFFloat", "SFVec3f", "SFColor", "SFRotation", "SFVec2f", "SFDouble"):
+        return None
+    try:
+        xs = [_flat(v) for v in values]
+        n, d = len(xs), len(xs[0])
+    except (TypeError, ValueError):
+        return None
+    lo = n // 10
+
+    def err(L):
+        k = int(L)
+        w = L - k
+        tot = 0.0
+        for i in range(lo, n - k - 1):
+            a, b, c = xs[i], xs[i + k], xs[i + k + 1]
+            tot += sum(abs(a[j] - (b[j] + w * (c[j] - b[j]))) for j in range(d))
+        return tot / max(1, n - k - 1 - lo)
+
+    lags = [(err(float(k)), k) for k in range(4, n // 3)]
+    if not lags:
+        return None
+    scale = sorted(e for e, _ in lags)[len(lags) // 2]
+    best = min(e for e, _ in lags)
+    if scale <= 0 or best > 0.1 * scale:
+        return None
+    k = next(k for e, k in lags if e <= 1.3 * best + 1e-9 and (k == 4 or e <= lags[k - 5][0]))      # first low point
+    a, b = float(k - 1), float(k + 1)
+    for _ in range(40):
+        c, e = a + 0.382 * (b - a), b - 0.382 * (b - a)
+        if err(c) < err(e):
+            b = e
+        else:
+            a = c
+    return round((a + b) / 2 * DT, 6)
+
