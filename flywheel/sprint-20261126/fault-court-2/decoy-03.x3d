<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="decoy-03"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
<Transform><Shape><Appearance><Material diffuseColor="1 0 0"/></Appearance><Box/></Shape><TouchSensor DEF="Touch"/></Transform>
<Transform translation="3 0 0"><Shape><Appearance><Material diffuseColor="1 0 0"/></Appearance><Box/></Shape><TouchSensor USE="Touch"/></Transform>
<TimeSensor DEF="Clock" cycleInterval="2"/>
<ROUTE fromNode="Touch" fromField="touchTime" toNode="Clock" toField="startTime"/>
  </Scene>
</X3D>
