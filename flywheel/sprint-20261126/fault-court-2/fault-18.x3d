<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="fault-18"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
<Transform DEF="A"><Shape><Appearance><Material diffuseColor="1 0 0"/></Appearance><Box/></Shape></Transform>
<Transform DEF="B"><Shape><Appearance><Material diffuseColor="1 0 0"/></Appearance><Box/></Shape></Transform>
<ROUTE fromNode="A" fromField="translation_changed" toNode="B" toField="set_translation"/>
<ROUTE fromNode="B" fromField="translation_changed" toNode="A" toField="set_translation"/>
  </Scene>
</X3D>
