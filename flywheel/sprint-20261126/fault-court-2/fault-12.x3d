<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="fault-12"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
<TimeSensor DEF="Clock" cycleInterval="4" loop="true"/>
<Group><Shape><Appearance><Material/></Appearance><Box/></Shape></Group>
<Group><TouchSensor DEF="Touch"/></Group>
<ROUTE fromNode="Touch" fromField="touchTime" toNode="Clock" toField="set_startTime"/>
  </Scene>
</X3D>
