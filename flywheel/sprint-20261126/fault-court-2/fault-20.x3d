<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="fault-20"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
<TimeSensor DEF="Clock" cycleInterval="4" loop="true"/>
<Transform DEF="T"><Shape><Appearance><Material diffuseColor="1 0 0"/></Appearance><Box/></Shape></Transform>
<Script DEF="S"><field name="set_f" type="SFFloat" accessType="inputOnly"/><field name="out" type="SFVec3f" accessType="outputOnly"/></Script>
<ROUTE fromNode="Clock" fromField="fraction_changed" toNode="S" toField="set_f"/>
<ROUTE fromNode="S" fromField="out" toNode="T" toField="set_translation"/>
  </Scene>
</X3D>
