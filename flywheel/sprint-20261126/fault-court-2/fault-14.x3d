<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head><meta name="title" content="fault-14"/></head>
  <Scene>
    <Viewpoint position="0 0 10"/>
<Transform><Shape><Appearance><Material diffuseColor="1 0 0"/></Appearance><Box/></Shape><TouchSensor DEF="Touch"/></Transform>
<BooleanToggle DEF="Tog"/>
<ROUTE fromNode="Touch" fromField="isActive" toNode="Tog" toField="set_boolean"/>
  </Scene>
</X3D>
