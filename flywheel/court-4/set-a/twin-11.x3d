<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Immersive' version='4.0'>
  <head>
    <meta name='description' content="A three-frame sign that shows a red cube, then a green ball, then a blue cone, one second each, over and over."/>
  </head>
  <Scene>
    <Viewpoint description='Front' position='0 0 8'/>
    <Switch DEF='Frames' whichChoice='0'>
      <Shape DEF='RedCube'>
        <Appearance>
          <Material diffuseColor='1 0 0'/>
        </Appearance>
        <Box/>
      </Shape>
      <Shape DEF='GreenBall'>
        <Appearance>
          <Material diffuseColor='0 1 0'/>
        </Appearance>
        <Sphere/>
      </Shape>
      <Shape DEF='BlueCone'>
        <Appearance>
          <Material diffuseColor='0 0 1'/>
        </Appearance>
        <Cone/>
      </Shape>
    </Switch>
    <TimeSensor DEF='FrameClock' cycleInterval='3' loop='true'/>
    <IntegerSequencer DEF='FramePicker' key='0 0.3333 0.6667' keyValue='0 1 2'/>
    <ROUTE fromNode='FrameClock' fromField='fraction_changed' toNode='FramePicker' toField='set_fraction'/>
    <ROUTE fromNode='FramePicker' fromField='value_changed' toNode='Frames' toField='set_whichChoice'/>
  </Scene>
</X3D>
