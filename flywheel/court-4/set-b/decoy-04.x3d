<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='description' content='A long-lens survey shot: a red marker box 4 m wide filmed from 400 m away through a very narrow field of view, so it still spans over a third of the frame width.'/>
  </head>
  <Scene>
    <NavigationInfo type='"EXAMINE" "ANY"' visibilityLimit='0'/>
    <Viewpoint DEF='LongLens' description='Telephoto from 400 m' position='0 0 400' fieldOfView='0.02' centerOfRotation='0 0 0'/>
    <Shape DEF='MarkerBox'>
      <Appearance>
        <Material diffuseColor='0.85 0.15 0.1'/>
      </Appearance>
      <Box size='4 2 2'/>
    </Shape>
  </Scene>
</X3D>
