<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='description' content='A closed ridge tent: two triangular gable ends, two sloping sides and a floor, built from six corner points.'/>
  </head>
  <Scene>
    <Viewpoint DEF='TentView' description='Tent from front right' position='3.5 2.5 5' orientation='-0.43045 0.89236 0.13569 0.67913'/>
    <Shape DEF='RidgeTent'>
      <Appearance>
        <Material diffuseColor='0.2 0.6 0.3'/>
      </Appearance>
      <IndexedFaceSet DEF='TentMesh' coordIndex='0 1 2 -1 4 3 5 -1 1 4 5 2 -1 3 0 2 5 -1 0 3 4 1 -1'>
        <Coordinate DEF='TentCorners' point='-1 0 1, 1 0 1, 0 1.5 1, -1 0 -1, 1 0 -1, 0 1.5 -1'/>
      </IndexedFaceSet>
    </Shape>
  </Scene>
</X3D>
