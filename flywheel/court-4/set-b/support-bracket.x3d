<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='description' content='Support file for pair 16: a red angle bracket (upright leg and foot) standing on the plane y = 0.'/>
  </head>
  <Scene>
    <Group DEF='AngleBracket'>
      <Transform DEF='UprightLeg' translation='0 0.75 0'>
        <Shape>
          <Appearance DEF='RedPaint'>
            <Material diffuseColor='0.85 0.1 0.1'/>
          </Appearance>
          <Box size='0.2 1.5 1'/>
        </Shape>
      </Transform>
      <Transform DEF='Foot' translation='0.5 0.1 0'>
        <Shape>
          <Appearance USE='RedPaint'/>
          <Box size='1 0.2 1'/>
        </Shape>
      </Transform>
    </Group>
  </Scene>
</X3D>
