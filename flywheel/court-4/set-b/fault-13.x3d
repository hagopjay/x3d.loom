<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='description' content='An outdoor ground slab with a white ball on it, lit only by a noon sun standing straight overhead so the top of the ground and of the ball are bright.'/>
  </head>
  <Scene>
    <NavigationInfo headlight='false'/>
    <Background skyColor='0.45 0.6 0.8'/>
    <Viewpoint DEF='HighCorner' description='From a high corner' position='5 6 8' orientation='-0.67286 0.71415 0.19297 0.76375'/>
    <DirectionalLight DEF='NoonSunOverhead' global='true' direction='0 1 0' intensity='1' ambientIntensity='0'/>
    <Transform DEF='Ground' translation='0 -0.1 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.5 0.7 0.4'/>
        </Appearance>
        <Box size='8 0.2 8'/>
      </Shape>
    </Transform>
    <Transform DEF='Ball' translation='0 1 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.9 0.9 0.9'/>
        </Appearance>
        <Sphere radius='1'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
