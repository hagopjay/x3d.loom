<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='description' content='A statue (cone on a pedestal with a blue back plate) and one camera placed 8 m behind it on the -Z side, looking back at the statue so its blue back plate fills the middle of the view.'/>
  </head>
  <Scene>
    <Viewpoint DEF='BackView' description='Back view of the statue' position='0 1 -8'/>
    <Transform DEF='Pedestal' translation='0 0.25 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.6 0.6 0.6'/>
        </Appearance>
        <Cylinder height='0.5' radius='1'/>
      </Shape>
    </Transform>
    <Transform DEF='Figure' translation='0 1.5 0'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.85 0.8 0.7'/>
        </Appearance>
        <Cone bottomRadius='0.7' height='2'/>
      </Shape>
    </Transform>
    <Transform DEF='BackPlate' translation='0 1.2 -0.8'>
      <Shape>
        <Appearance>
          <Material diffuseColor='0.1 0.2 0.8'/>
        </Appearance>
        <Box size='1 1.2 0.1'/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
