<?xml version='1.0' encoding='UTF-8'?>
<X3D profile='Interchange' version='4.0'>
  <head>
    <meta name='description' content='A pulse sphere named Pulse grows and shrinks forever; the clock has a stopTime earlier than its startTime, which is ignored by the standard, so it keeps looping.'/>
    <meta name='title' content='behaviour test scene'/>
  </head>
  <Scene>
    <Viewpoint DEF='Cam' description='Front' position='0 0 10'/>
    <Transform DEF='Pulse'><Shape><Appearance><Material diffuseColor='1 0.5 0'/></Appearance><Sphere/></Shape></Transform>
    <TimeSensor DEF='Clock' cycleInterval='1.5' loop='true' startTime='5' stopTime='2'/>
    <PositionInterpolator DEF='Grow' key='0 0.5 1' keyValue='1 1 1  2 2 2  1 1 1'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Grow' toField='set_fraction'/>
    <ROUTE fromNode='Grow' fromField='value_changed' toNode='Pulse' toField='set_scale'/>
  </Scene>
</X3D>
