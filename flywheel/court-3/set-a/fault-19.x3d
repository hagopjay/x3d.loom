<?xml version='1.0' encoding='UTF-8'?>
<X3D profile='Interchange' version='4.0'>
  <head>
    <component name='Networking' level='1'/>
    <meta name='description' content='Clicking the blue box (an Anchor) jumps the view to the Viewpoint DEF named CloseUp.'/>
    <meta name='title' content='behaviour test scene'/>
  </head>
  <Scene>
    <Viewpoint DEF='Cam2' description='Wide' position='0 0 12'/>
    <Viewpoint DEF='CloseUp' description='Close up' position='0 0 3'/>
    <Anchor url='"#Closeup"' description='Go close'><Shape><Appearance><Material diffuseColor='0 0 1'/></Appearance><Box/></Shape></Anchor>
  </Scene>
</X3D>
