<?xml version='1.0' encoding='UTF-8'?>
<X3D profile='Interchange' version='4.0'>
  <head>
    <meta name='description' content='A leader box moves along x under animation; a second box named Follower copies the leader position by a ROUTE from the leader translation output.'/>
    <meta name='title' content='behaviour test scene'/>
  </head>
  <Scene>
    <Viewpoint DEF='Cam' description='Front' position='0 0 10'/>
    <Transform DEF='Leader' translation='-3 1 0'><Shape><Appearance><Material diffuseColor='0 0.6 1'/></Appearance><Box/></Shape></Transform>
    <Transform DEF='Follower' translation='-3 -1 0'><Shape><Appearance><Material diffuseColor='0 1 0.4'/></Appearance><Box/></Shape></Transform>
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true'/>
    <PositionInterpolator DEF='Path' key='0 1' keyValue='-3 1 0  3 1 0'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Path' toField='set_fraction'/>
    <ROUTE fromNode='Path' fromField='value_changed' toNode='Leader' toField='set_translation'/>
    <ROUTE fromNode='Leader' fromField='translation_changed' toNode='Follower' toField='set_translation'/>
  </Scene>
</X3D>
