<?xml version='1.0' encoding='UTF-8'?>
<X3D profile='Interchange' version='4.0'>
  <head>
    <meta name='description' content='A hopping ball named Hopper jumps instantly from x equal to -3 to x equal to 3 at half time: repeated key 0.5 with two different values deliberately makes a step.'/>
    <meta name='title' content='behaviour test scene'/>
  </head>
  <Scene>
    <Viewpoint DEF='Cam' description='Front' position='0 0 10'/>
    <Transform DEF='Hopper' translation='-3 0 0'><Shape><Appearance><Material diffuseColor='0.9 0.4 0.1'/></Appearance><Sphere/></Shape></Transform>
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true'/>
    <PositionInterpolator DEF='Hop' key='0 0.5 0.5 1' keyValue='-3 0 0  -3 0 0  3 0 0  3 0 0'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='Hop' toField='set_fraction'/>
    <ROUTE fromNode='Hop' fromField='value_changed' toNode='Hopper' toField='set_translation'/>
  </Scene>
</X3D>
