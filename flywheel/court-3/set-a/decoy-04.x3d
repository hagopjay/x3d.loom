<?xml version='1.0' encoding='UTF-8'?>
<X3D profile='Interchange' version='4.0'>
  <head>
    <component name='PointingDeviceSensor' level='1'/>
    <meta name='description' content='Two touch sensors both start the same spin clock (several ROUTEs into one field), and one clock fraction drives two interpolators (several ROUTEs from one field).'/>
    <meta name='title' content='behaviour test scene'/>
  </head>
  <Scene>
    <Viewpoint DEF='Cam' description='Front' position='0 0 10'/>
    <Group><TouchSensor DEF='TouchA'/><Transform translation='-3 0 0'><Shape><Appearance><Material diffuseColor='1 0 0'/></Appearance><Sphere/></Shape></Transform></Group>
    <Group><TouchSensor DEF='TouchB'/><Transform translation='3 0 0'><Shape><Appearance><Material diffuseColor='0 0 1'/></Appearance><Sphere/></Shape></Transform></Group>
    <Transform DEF='SpinnerA' translation='0 2 0'><Shape><Appearance><Material diffuseColor='0.8 0.8 0'/></Appearance><Box/></Shape></Transform>
    <Transform DEF='SpinnerB' translation='0 -2 0'><Shape><Appearance><Material diffuseColor='0.8 0 0.8'/></Appearance><Box/></Shape></Transform>
    <TimeSensor DEF='Clock' cycleInterval='4' loop='true' enabled='true'/>
    <OrientationInterpolator DEF='TurnA' key='0 0.5 1' keyValue='0 1 0 0  0 1 0 3.14159  0 1 0 6.28318'/>
    <OrientationInterpolator DEF='TurnB' key='0 0.5 1' keyValue='1 0 0 0  1 0 0 3.14159  1 0 0 6.28318'/>
    <ROUTE fromNode='TouchA' fromField='touchTime' toNode='Clock' toField='set_startTime'/>
    <ROUTE fromNode='TouchB' fromField='touchTime' toNode='Clock' toField='set_startTime'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='TurnA' toField='set_fraction'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='TurnB' toField='set_fraction'/>
    <ROUTE fromNode='TurnA' fromField='value_changed' toNode='SpinnerA' toField='set_rotation'/>
    <ROUTE fromNode='TurnB' fromField='value_changed' toNode='SpinnerB' toField='set_rotation'/>
  </Scene>
</X3D>
