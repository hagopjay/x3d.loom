<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Interchange' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='twin-18.x3d'/>
    <meta name='description' content='A switch of three shapes (box, sphere, cone) set to show the third one, the blue cone.'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 8' description='Front'/>
    <Switch whichChoice='2'>
      <Shape><Appearance><Material diffuseColor='1 0 0'/></Appearance><Box/></Shape>
      <Shape><Appearance><Material diffuseColor='0 1 0'/></Appearance><Sphere/></Shape>
      <Shape><Appearance><Material diffuseColor='0 0 1'/></Appearance><Cone/></Shape>
    </Switch>

  </Scene>
</X3D>
