<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Interchange' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='fault-11.x3d'/>
    <meta name='description' content='An orange NURBS curve arching across the view.'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 8' description='Front'/>
    <Shape>
      <Appearance><Material emissiveColor='1 0.5 0'/></Appearance>
      <NurbsCurve order='3' knot='0 0 0 1 2 3 3 3'>
        <CoordinateDouble point='-3 0 0, -2 2 0, 0 -2 0, 2 2 0, 3 0 0'/>
      </NurbsCurve>
    </Shape>

  </Scene>
</X3D>
