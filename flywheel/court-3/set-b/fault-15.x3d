<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Interchange' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='fault-15.x3d'/>
    <meta name='description' content='A door hinged on its left edge and swung open by a quarter turn (ninety degrees).'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 8' description='Front'/>
    <Transform DEF='DoorHinge' translation='-1 0 0' rotation='0 1 0 90'>
      <Transform translation='1 0 0'>
        <Shape DEF='Door'><Appearance><Material diffuseColor='0.6 0.3 0.1'/></Appearance><Box size='2 3 0.2'/></Shape>
      </Transform>
    </Transform>
    <Shape><Appearance><Material diffuseColor='0.5 0.5 0.5'/></Appearance><Box size='0.2 3 0.2'/></Shape>

  </Scene>
</X3D>
