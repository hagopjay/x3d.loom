<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Interchange' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='twin-20.x3d'/>
    <meta name='description' content='A grey sphere lit from straight above by a sun, with the headlight off.'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 8' description='Front'/>
    <NavigationInfo headlight='false'/>
    <DirectionalLight DEF='Sun' direction='0 -1 0' intensity='1'/>
    <Transform><Shape><Appearance><Material diffuseColor='0.8 0.8 0.8'/></Appearance><Sphere radius='1.5'/></Shape></Transform>

  </Scene>
</X3D>
