<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Interchange' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='twin-16.x3d'/>
    <meta name='description' content='A wide-angle (sixty degree) view of a four metre box seen from twelve metres.'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 12' fieldOfView='1.0472' description='Wide'/>
    <Transform><Shape><Appearance><Material diffuseColor='0.6 0.6 0.9'/></Appearance><Box size='4 4 4'/></Shape></Transform>

  </Scene>
</X3D>
