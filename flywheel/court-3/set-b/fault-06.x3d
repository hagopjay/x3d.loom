<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Interchange' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='fault-06.x3d'/>
    <meta name='description' content='A tall red tower made by instancing a Tower prototype with a colour and a height.'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 8' description='Front'/>
    <ProtoDeclare name='Tower'>
      <ProtoInterface>
        <field accessType='initializeOnly' type='SFColor' name='towerColor' value='0.5 0.5 0.5'/>
        <field accessType='initializeOnly' type='SFFloat' name='towerHeight' value='1'/>
      </ProtoInterface>
      <ProtoBody>
        <Shape>
          <Appearance><Material>
            <IS><connect nodeField='diffuseColor' protoField='towerColor'/></IS>
          </Material></Appearance>
          <Cylinder radius='0.7'>
            <IS><connect nodeField='height' protoField='towerHeight'/></IS>
          </Cylinder>
        </Shape>
      </ProtoBody>
    </ProtoDeclare>
    <ProtoInstance name='Tower' DEF='RedTower'>
      <fieldValue name='towerColour' value='0.9 0.1 0.1'/>
      <fieldValue name='towerHeight' value='3'/>
    </ProtoInstance>

  </Scene>
</X3D>
