<?xml version="1.0" encoding="UTF-8"?>
<X3D profile='Interchange' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <meta name='title' content='twin-07.x3d'/>
    <meta name='description' content='A square panel showing the four-colour two by two texture exactly once, one colour per quadrant.'/>
  </head>
  <Scene>
    <Viewpoint position='0 0 8' description='Front'/>
    <Shape>
      <Appearance><Material diffuseColor='1 1 1'/><PixelTexture image='2 2 3 0xFF0000 0x00FF00 0x0000FF 0xFFFF00'/></Appearance>
      <IndexedFaceSet coordIndex='0 1 2 3 -1'>
        <Coordinate point='-2 -2 0, 2 -2 0, 2 2 0, -2 2 0'/>
        <TextureCoordinate point='0 0, 1 0, 1 1, 0 1'/>
      </IndexedFaceSet>
    </Shape>

  </Scene>
</X3D>
